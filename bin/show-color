#!/bin/bash

# Define the rendering logic in a function to keep it DRY (Don't Repeat Yourself)
render_color() {
  local text=$1
  local color=$(echo "$text" | grep -E --only-matching '#[0-9a-fA-F]{6}')
  # Strip the leading #
  local hex=${color#\#}

  # Convert hex chunks to decimal using 0x prefix
  local r=$(printf "%d" "0x${hex:0:2}")
  local g=$(printf "%d" "0x${hex:2:2}")
  local b=$(printf "%d" "0x${hex:4:2}")

  # Print the block and the string
  printf "\e[48;2;%s;%s;%sm    \e[0m %s\n" "$r" "$g" "$b" "$text"
}

# 1. If arguments are passed (e.g., ./color.sh #123123)
if [ $# -gt 0 ]; then
  for arg in "$@"; do
    render_color "$arg"
  done
# 2. Otherwise, check if stdin is a pipe and read from it
else
  while read -r line; do
    [[ -n "$line" ]] && render_color "$line"
  done
fi
