#!/usr/bin/env bash
# Report what may need action: GitHub links in tracked files whose issue, PR or
# discussion has since closed, unread GitHub activity, open PRs of ours that
# need work, and local drift. Reports only; the /maintenance pi prompt judges
# the findings (docs/adr/0096).
# Usage: maintenance [--new]
#   --new  print only items no earlier --new run printed, and remember them
# Exit 0 when there is nothing to report, 1 when there is.
set -euo pipefail

state=${XDG_STATE_HOME:-$HOME/.local/state}
seen=$state/maintenance/seen
bootstrap_log=$state/yadm/bootstrap.log

new_only=false
case ${1:-} in
  --new) new_only=true ;;
  '') ;;
  *)
    echo "Usage: maintenance [--new]" >&2
    exit 2
    ;;
esac

# Item lines are indented two spaces; four-space lines under one are its context.
# ADRs and filed-issue examples are history; the .orig files are vendored upstream copies.
locations() {
  (cd "$HOME" && yadm grep -nIoE 'github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/(pull|issues|discussions)/[0-9]+' \
    -- ':!.config/docs/adr' ':!*/past_issues/*' ':!*.orig') |
    jq -R 'capture("^(?<path>[^:]+):(?<line>[0-9]+):github\\.com/(?<ref>.+)$")' | jq -s . || true
}

# One request for every referenced item and our open PRs; partial errors
# (a deleted repository) still return the rest of the data.
github_query() {
  jq -r '
    [map(.ref) | unique | to_entries[] | .value as $ref | ($ref | split("/")) as [$owner, $name, $kind, $n] |
      "r\(.key): repository(owner: \($owner | tojson), name: \($name | tojson)) { " +
      (if $kind == "discussions"
       then "discussion(number: \($n)) { closed closedAt stateReason }"
       else "issueOrPullRequest(number: \($n)) { ... on Issue { state stateReason closedAt } ... on PullRequest { state mergedAt closedAt } }"
       end) + " }"] |
    "query { viewer { pullRequests(states: OPEN, first: 100) { nodes { number title reviewDecision mergeable repository { nameWithOwner } commits(last: 1) { nodes { commit { statusCheckRollup { state } } } } } } } " + join(" ") + " }"'
}

resolved_upstream() { # <locations json> <response json>
  jq -r --argjson locs "$1" '
    ($locs | map(.ref) | unique) as $refs | .data as $data |
    $refs | to_entries[] | .value as $ref | $data["r\(.key)"] as $repo |
    ($repo.issueOrPullRequest // $repo.discussion) as $item |
    (if $repo == null or $item == null then "not found"
     elif $item.state == "MERGED" then "merged \($item.mergedAt[:10])"
     elif $item.state == "CLOSED" or $item.closed == true
     then "closed \($item.closedAt[:10])" + (if $item.stateReason then " (\($item.stateReason | ascii_downcase | gsub("_"; " ")))" else "" end)
     else empty end) as $status |
    ($ref | split("/")) as [$owner, $name, $kind, $n] |
    "  \($owner)/\($name)#\($n) \($status)",
    ($locs[] | select(.ref == $ref) | "    ~/\(.path):\(.line)")' <<<"$2"
}

open_prs() {
  jq -r '.data.viewer.pullRequests.nodes[] |
    [(if .reviewDecision == "CHANGES_REQUESTED" then "changes requested" else empty end),
     (if .mergeable == "CONFLICTING" then "conflicts" else empty end),
     (if (.commits.nodes[0].commit.statusCheckRollup.state // "") | test("FAILURE|ERROR") then "checks failing" else empty end)] as $why |
    select($why | length > 0) |
    "  \(.repository.nameWithOwner)#\(.number) \($why | join(", ")): \(.title)"'
}

# CI runs are noise here: failing checks on our own PRs come from open_prs.
notifications() {
  timeout 30 gh api --paginate 'notifications?per_page=100' --jq '.[] | select(.reason != "ci_activity") |
    (((.subject.url // "") | capture("/(?<n>[0-9]+)$").n) // "") as $n |
    "  \(.repository.full_name)\(if $n == "" then "" else "#\($n)" end) \(.reason | gsub("_"; " ")): \(.subject.title) (\(.updated_at[:10]))"'
}

# A plugin clone whose fix lives on the user's fork carries an `upstream` remote
# beside origin (ADR-0122). A fork that has fallen behind, or whose patch has
# reached upstream, is drift nobody would otherwise notice.
plugin_forks() {
  local dir name base_ref base listed unmerged behind
  for dir in "$HOME"/.config/omarchy/plugins/*/.git; do
    dir=${dir%/.git}
    git -C "$dir" remote get-url upstream &>/dev/null || continue
    name=${dir##*/}
    # A fork that cannot be reached is left alone: a stale ref is not drift.
    timeout 15 git -C "$dir" fetch --quiet upstream 2>/dev/null || continue
    base_ref=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/upstream/HEAD 2>/dev/null ||
      echo upstream/main)
    base=$(git -C "$dir" rev-parse --verify --quiet "$base_ref" 2>/dev/null || true)
    [[ -n $base ]] || continue
    # By patch identity, so a squash or a rebase upstream still counts as landed.
    # A listing that cannot be read is not a landing, so it is skipped instead.
    listed=$(git -C "$dir" cherry "$base" HEAD 2>/dev/null) || continue
    unmerged=$(grep -c '^+' <<<"$listed" || true)
    if ((unmerged == 0)); then
      echo "  fork patch reached upstream: $name"
      echo "    git -C $dir fetch upstream && git reset --hard $base_ref && git push --force origin main"
      continue
    fi
    behind=$(git -C "$dir" rev-list --count "HEAD..$base" 2>/dev/null || echo 0)
    if ((behind > 0)); then
      echo "  fork patch behind upstream by $behind: $name"
      echo "    git -C $dir rebase $base_ref && git push --force origin main"
    fi
  done
}

# Static provider keys belong in the encrypted pi/agent/.env (docs/secrets.md). A /login
# api key lands in the plain auth.json until adopt-keys moves it; a locked or plain-text
# .env, or a models.json entry with no key behind it, breaks that quietly.
provider_keys() {
  local agent=${PI_CODING_AGENT_DIR:-$HOME/.config/pi/agent} stray name missing=
  local tracked=${agent#"$HOME/"}/.env
  stray=$(jq -r 'to_entries[] | select(.value.type == "api_key") | .key' "$agent/auth.json" 2>/dev/null | paste -sd, -)
  if [[ -n $stray ]]; then
    echo "  api keys outside the encrypted .env: $stray"
    echo "    $agent/bin/adopt-keys"
  fi
  [[ -f $agent/.env ]] || return 0
  # git-crypt files start with \0GITCRYPT: present in the tree means still locked, in HEAD means encrypted.
  if [[ $(head -c 10 "$agent/.env" | tail -c 9) == GITCRYPT ]]; then
    echo "  pi/agent/.env is locked; its providers have no keys"
    echo "    yadm git-crypt unlock"
    return 0
  fi
  if [[ $(yadm show "HEAD:$tracked" 2>/dev/null | head -c 10 | tail -c 9) != GITCRYPT ]]; then
    echo "  pi/agent/.env is not encrypted in HEAD"
    echo "    yadm add-secret $agent/.env"
  fi
  for name in $(grep -o 'env-key [A-Z0-9_]*' "$agent/models.json" | cut -d' ' -f2); do
    grep -q "^$name=" "$agent/.env" || missing+="${missing:+,}$name"
  done
  if [[ -n $missing ]]; then
    echo "  models.json reads keys the .env lacks: $missing"
  fi
}

# Pi's path denies are the source; Claude's Read denies must cover each one, mapped
# (~/x/* becomes ~/x/**, a bare *pattern matches anywhere, so it is anchored at //**/).
permission_drift() {
  local pi=${PI_CODING_AGENT_DIR:-$HOME/.config/pi/agent}/extensions/pi-permission-system/config.json
  local claude=$HOME/.config/claude/settings.json pattern want missing=
  [[ -f $pi && -f $claude ]] || return 0
  while IFS= read -r pattern; do
    case $pattern in
      '~/'*'/*') want=${pattern%/\*}/** ;;
      '~/'*) want=$pattern ;;
      \**) want=//**/$pattern ;;
      *) want=$pattern ;;
    esac
    jq -e --arg r "Read($want)" '.permissions.deny | index($r)' "$claude" &>/dev/null ||
      missing+="${missing:+, }$want"
  done < <(jq -r '.permission.path | to_entries[] | select(.value == "deny") | .key' "$pi")
  if [[ -n $missing ]]; then
    echo "  claude read denies lack pi's path denies: $missing"
    echo "    edit claude/settings.json permissions.deny to match $pi"
  fi
}

local_drift() {
  yadm status --porcelain --untracked-files=no | cut -c4- | sed 's|^|  uncommitted: ~/|'
  if (($(yadm rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0) > 0)); then
    echo "  unpushed commits on $(yadm branch --show-current)"
    echo "    yadm log @{upstream}..HEAD"
  fi
  plugin_forks
  provider_keys
  permission_drift
  # The vault (docs/plans/vault.md): pass commits, never pushes, and its git half
  # fails silently (docs/secrets.md), so both halves are checked here.
  local vault=${PASSWORD_STORE_DIR:-$HOME/.local/share/secrets}
  if git -C "$vault" rev-parse --git-dir &>/dev/null; then
    if (($(git -C "$vault" rev-list --count '@{upstream}..HEAD' 2>/dev/null || echo 0) > 0)); then
      echo "  unpushed commits in the vault"
      echo "    git -C $vault push"
    fi
    git -C "$vault" status --porcelain --untracked-files=all | cut -c4- | sed "s|^|  vault file not in git: $vault/|"
  fi
  if [[ -f $bootstrap_log ]]; then
    sed 's/\x1b\[[0-9;]*m//g' "$bootstrap_log" | grep -E '^\[(WARN|ERROR)\]|WARNING' | sed 's/^/  bootstrap: /' || true
  fi
  if command -v systemctl &>/dev/null; then
    { systemctl --failed --plain --no-legend; systemctl --user --failed --plain --no-legend; } 2>/dev/null |
      awk '{ print "  failed unit: " $1 }'
  fi
  if command -v pacman &>/dev/null; then
    find /etc \( -name '*.pacnew' -o -name '*.pacsave' \) 2>/dev/null | sed 's/^/  config to merge: /' || true
  fi
}

section() { # <title> <lines>
  [[ -z $2 ]] || printf '%s\n%s\n' "$1" "$2"
}

skipped=()
resolved="" prs="" activity=""
locs=$(locations)
if ! command -v gh &>/dev/null; then
  skipped+=("GitHub: gh is not installed")
else
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  notifications >"$tmp/activity" 2>/dev/null &
  notifications_pid=$!
  response=$(github_query <<<"$locs" | timeout 30 gh api graphql -F query=@- 2>/dev/null || true)
  if jq -e '.data.viewer' <<<"${response:-null}" &>/dev/null; then
    resolved=$(resolved_upstream "$locs" "$response")
    prs=$(open_prs <<<"$response")
  else
    skipped+=("GitHub: unreachable or not authenticated (gh auth status)")
  fi
  if wait "$notifications_pid"; then
    activity=$(<"$tmp/activity")
  else
    skipped+=("GitHub notifications: request failed")
  fi
fi

report=$(
  section "Resolved upstream" "$resolved"
  section "Needs you" "$(printf '%s\n' "$prs" "$activity" | sed '/^$/d')"
  section "Local" "$(local_drift)"
)

if $new_only; then
  mkdir -p "${seen%/*}"
  touch "$seen"
  new=$(grep '^  [^ ]' <<<"$report" | grep -vxFf "$seen" || true)
  [[ -n $new ]] || exit 0
  printf '%s\n' "$new"
  # Bounded, newest last; an item that disappears and returns unchanged stays seen.
  { cat "$seen"; printf '%s\n' "$new"; } | tail -n 2000 >"$seen.tmp" && mv "$seen.tmp" "$seen"
  exit 1
fi

[[ -n $report ]] && printf '%s\n' "$report"
if ((${#skipped[@]})); then
  echo "Skipped"
  printf '    %s\n' "${skipped[@]}"
fi
[[ -z $report ]]
