#!/usr/bin/env bash

args=()
query=()
rg_globs=
rg_paths=
# Does not handle --flag value pairs, only --flag=value
while [[ "$#" -gt 0 ]]; do
  case $1 in
    --dir=*) rg_paths+=" $(printf %q "${1#--dir=}")" ;;
    --glob=*) rg_globs+=" --glob=$(printf %q "${1#--glob=}")" ;;
    --*) args+=("$1") ;;
    *) query+=("$1") ;;
  esac
  shift
done

RG_PREFIX="rg --column --line-number --no-heading --color=always --smart-case$rg_globs "
# rg prefixes matches with the searched directory, so paths stay valid from $PWD
[[ -n "$rg_paths" ]] && RG_SUFFIX=" --$rg_paths"
INITIAL_QUERY="${query[*]}"
fzf --ansi --disabled --query "$INITIAL_QUERY" \
  --bind "start:reload:$RG_PREFIX {q}$RG_SUFFIX" \
  --bind "change:reload:sleep 0.1; $RG_PREFIX {q}$RG_SUFFIX || true" \
  --bind "alt-enter:unbind(change,alt-enter)+change-prompt(2. fzf> )+enable-search+clear-query" \
  --color "hl:-1:underline,hl+:-1:underline:reverse" \
  --prompt '1. ripgrep> ' \
  --delimiter : \
  --preview 'preview {1} {2}' \
  --preview-window '+{2}/2' \
  --accept-nth 1 \
  "${args[@]}"
