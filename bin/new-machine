#!/usr/bin/env bash
# Take a bare machine to this repository's configuration in one step: git, a
# temporary yadm, the clone, then `yadm bootstrap`. Idempotent, so it also
# brings an existing machine up to date.
#
#   bash <(curl -fsSL https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/bin/new-machine)
#   bash <(wget -qO- https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/bin/new-machine)
#
# Run it rather than sourcing it: it ends by replacing itself with
# `yadm bootstrap`. The one thing it cannot do is fetch itself, so a machine
# with neither curl nor wget needs one of them first (`sudo apt-get install -y
# curl`, `sudo pacman -S curl`).
#
# Repo files it needs (bin/pkg-install) are fetched, not copied here, so there
# is one install routine for every distro.

# Before `set -e`, which a sourced script would leave behind in the caller's shell
if [[ ${BASH_SOURCE[0]} != "$0" ]]; then
  echo "new-machine: run it, do not source it." >&2
  return 1
fi

set -euo pipefail

REPO_URL=https://github.com/Susensio/dotfiles.yadm.git
REPO_BRANCH=master
RAW_URL=https://raw.githubusercontent.com/Susensio/dotfiles.yadm/$REPO_BRANCH
# `##distro_family` classes need at least this, and this is the version fetched
YADM_MIN=3.5.0
YADM_URL=https://raw.githubusercontent.com/yadm-dev/yadm/$YADM_MIN/yadm
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}

usage() {
  cat <<EOF
Usage: new-machine [--checkout]

  --checkout  Replace files this repository already tracks, e.g. on Omarchy
              (same as \`yadm checkout -- $CONFIG_DIR\`). Without it, a clone
              that finds existing files stops and prints that command.
  --help      This text.
EOF
}

log() { printf '%s\n' "$*" >&2; }

# A bare Debian has wget and no curl; Arch has curl
fetch() {
  if command -v curl &> /dev/null; then
    curl -fsSL "$1"
  else
    wget -qO- "$1"
  fi
}

yadm_is_current() {
  local version
  version=$(yadm --version 2>/dev/null | sed -n 's/^yadm version \([0-9.]*\)$/\1/p')
  [[ -n $version ]] || return 1
  # sort -V: 3.10 is newer than 3.5, which a string compare gets wrong
  [[ $(printf '%s\n%s\n' "$YADM_MIN" "$version" | sort -V | head -1) == "$YADM_MIN" ]]
}

install_deps() {
  local work
  work=$(mktemp -d)

  if ! command -v git &> /dev/null; then
    log "Installing git..."
    fetch "$RAW_URL/bin/pkg-install" > "$work/pkg-install"
    bash "$work/pkg-install" git
  fi

  if ! yadm_is_current; then
    # Held in a temp dir for this run only: the bootstrap installs the managed
    # yadm (pacman on Arch, mise elsewhere), so a distro package would be a
    # second copy, and a file in ~/.local/bin would block mise linking its own
    log "Fetching yadm $YADM_MIN for this run..."
    mkdir "$work/bin"
    fetch "$YADM_URL" > "$work/bin/yadm"
    chmod +x "$work/bin/yadm"
    PATH=$work/bin:$PATH
    yadm_is_current || { log "yadm still older than $YADM_MIN; giving up."; return 1; }
  fi
}

clone_repo() {
  local checkout=$1
  if yadm introspect repo &> /dev/null; then
    log "Already cloned at $(yadm introspect repo); leaving it alone."
    return 0
  fi

  log "Cloning $REPO_URL..."
  # --no-bootstrap: the bootstrap runs once, at the end, without yadm's prompt
  if yadm clone --no-bootstrap -b "$REPO_BRANCH" "$REPO_URL"; then
    return 0
  fi

  if ! $checkout; then
    log ""
    log "The clone found files this repository already tracks. Review them, then"
    log "rerun with --checkout, or run: yadm checkout -- $CONFIG_DIR"
    return 1
  fi
  log "Adopting the tracked versions of the files above..."
  yadm checkout -- "$CONFIG_DIR"
}

main() {
  local checkout=false
  while (( $# )); do
    case $1 in
      --checkout) checkout=true ;;
      -h | --help) usage; return 0 ;;
      *) log "Unknown argument: $1"; usage >&2; return 2 ;;
    esac
    shift
  done

  install_deps
  clone_repo "$checkout"

  log "Running yadm bootstrap..."
  exec yadm bootstrap
}

main "$@"
