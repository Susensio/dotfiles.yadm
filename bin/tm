#!/usr/bin/env bash
SCRIPTS_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts"
MAIN_SESSION=main

# Start new session in PWD
if [[ "$PWD" != "$HOME" ]]; then
  exec "${SCRIPTS_DIR}/sessionizer" "$PWD"
fi

# Create main session
if ! tmux has-session -t "=$MAIN_SESSION"; then
  exec tmux new-session -s "$MAIN_SESSION"
fi

# Attach main session
is_detached=$(tmux display -t "=$MAIN_SESSION:" -p -F "#{!:#{session_attached}}")
if [[ "$is_detached" == "1" ]]; then
  exec tmux attach -t "=$MAIN_SESSION"
fi

# Create new session from list
exec "${SCRIPTS_DIR}/sessionizer"
