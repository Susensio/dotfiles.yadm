#!/bin/bash
IFS=$'\n'
# Five arguments are passed to the file, (1) current file name, (2) width, (3) height, (4) horizontal position, and (5) vertical position of preview pane respectively.
## Script arguments
file_path=$(echo $1 | sed "s|~|$HOME|g")
line_number=${2:-}

[ -n "${FZF_PREVIEW_COLUMNS}" ] &&
  pv_width="$((FZF_PREVIEW_COLUMNS - 2))" ||
  pv_width=$(tput cols)
[ -n "${FZF_PREVIEW_LINES}" ] &&
  pv_height="$((FZF_PREVIEW_LINES - 2))" ||
  pv_height=$(tput lines)

file_extension=$(echo "${file_path##*.}" | tr '[:upper:]' '[:lower:]')

mimetype=$(file --dereference --brief --mime-type -- "$file_path")

case "$mimetype" in
  */directory) eza --tree --group-directories-first --level=2 --git-ignore --color=always --icons -- "$file_path" ;;
  image/*) chafa "$file_path" -s "$pv_width"x"$pv_height" ;;
  */pdf) pdftotext "$file_path" - ;;
  text/* | */xml | application/json)
    # bat --color=always --style=plain --line-range=:500 \
    #   --paging=never --terminal-width="$pv_width" \
    #   "$file_path"
    if [[ -n "$line_number" ]]; then
      bat_args=(--line-range=":$((line_number + 500))" --highlight-line="$line_number")
    else
      bat_args=(--line-range=:500)
    fi

    # yadm alternate/template suffixes break bat's syntax detection
    # (e.g. packages.toml##default, tmux-palette.conf.tpl); ignore them so
    # the underlying file type gets highlighted
    case "${file_path##*/}" in
      *'##'*) bat_args+=(--ignored-suffix="##${file_path##*##}") ;;
    esac
    case "${file_path##*/}" in
      *.tpl) bat_args+=(--ignored-suffix=.tpl) ;;
    esac

    bat --color=always --style=plain --paging=never \
      --terminal-width="$pv_width" "${bat_args[@]}" \
      "$file_path"
    ;;
  *)
    case "$file_extension" in
      tar*) tar tf "$file_path" ;;
      zip) unzip -l "$file_path" ;;
      rar) unrar l "$file_path" ;;
      7z) 7z l "$file_path" ;;
      *)
        echo '----- File Type Classification -----'
        file --dereference --brief -- "$file_path"
        # file --dereference --brief -- "$file_path" |
        #   fold --spaces --width="$pv_width"
        ;;
    esac
    ;;
esac
