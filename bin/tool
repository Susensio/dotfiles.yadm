#!/usr/bin/env bash
# @describe Manage global tools using mise with an apt-like interface.
set -euo pipefail
[[ "${DEBUG:-}" == "1" ]] && set -x

# On Arch, tools pacman packages go to both packages.toml variants; the rest go to
# tools.toml (docs/adr/0046). config.toml is machine-local (docs/adr/0045).
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/mise
TOOLS_CONFIG=$CONFIG_DIR/conf.d/tools.toml
PACKAGES_MISE=$CONFIG_DIR/conf.d/packages.toml##default
PACKAGES_ARCH=$CONFIG_DIR/conf.d/packages.toml##distro.arch

# @cmd Install global tools, or promote ones installed with plain `mise use -g`
# @flag --lsp Install into the global LSP config
# @arg tools+ Tool specifications, optionally including a version
install() {
  if [[ "${argc_lsp:-}" == "1" ]]; then
    mise use --global --path "$CONFIG_DIR/conf.d/lsp.toml" "${argc_tools[@]}"
    return
  fi

  local tool name
  for tool in "${argc_tools[@]}"; do
    # Drop a trailing @version, but not the @ of an npm:@scope/pkg
    name=$tool
    [[ ${tool##*@} == */* ]] || name=${tool%@*}
    if declared "$TOOLS_CONFIG" "$name" && [[ $name == "$tool" ]]; then
      mise install "$tool"
    elif declared "$PACKAGES_MISE" "$name"; then
      # Already a distro tool: pacman on Arch, mise elsewhere
      if command -v pacman &>/dev/null; then
        [[ $name == "$tool" ]] || echo "tool: pacman cannot pin $tool; installing the repo version" >&2
        mise bootstrap --only packages --yes
      elif [[ $name == "$tool" ]]; then
        mise install "$tool"
      else
        mise use --global --path "$PACKAGES_MISE" "$tool"
      fi
    elif [[ $tool =~ ^[A-Za-z0-9_.+-]+$ ]] && command -v pacman &>/dev/null && pacman -Si "$tool" &>/dev/null; then
      mise config set --file "$PACKAGES_MISE" "tools.$tool" latest
      mise bootstrap packages use --yes --path "$PACKAGES_ARCH" "pacman:$tool"
    else
      mise use --global --path "$TOOLS_CONFIG" "$tool"
    fi
    # Drops it from config.toml, if plain `mise use -g` put it there
    mise unuse --global --no-prune "$name"
  done
  mise run system-install --only-prune
}

# @cmd Upgrade all or specific installed tools
# @arg tools* Tools to upgrade
upgrade() {
  mise upgrade "${argc_tools[@]}" --bump
}

# @cmd Set up an alias for a tool
# @arg name! Alias name
# @arg tool! Tool
alias() {
  # tool-alias set has no --path; it always writes to the global config file
  MISE_GLOBAL_CONFIG_FILE="$TOOLS_CONFIG" mise tool-alias set "$argc_name" "$argc_tool"
}

# @cmd Remove one or more global tools
# @arg tools+ Tools to remove
remove() {
  local tool file
  for tool in "${argc_tools[@]}"; do
    for file in "$TOOLS_CONFIG" "$PACKAGES_MISE"; do
      ! declared "$file" "$tool" || mise unuse --path "$file" "$tool"
    done
    # mise has no command to drop a [bootstrap.packages] entry
    sed -i "/^\"pacman:$tool\" = /d" "$PACKAGES_ARCH"
  done
  mise run system-install --only-prune
}

# @cmd Search for tools, or list installed global tools
# @flag --installed List installed global tools
# @arg tools* Tools to search for or list
list() {
  if [[ "${argc_installed:-}" == "1" ]]; then
    mise list --global "${argc_tools[@]}"
  else
    mise search "${argc_tools[@]}"
  fi
}

# @cmd Show details about a specific tool
# @arg tool! Tool
show() {
  mise tool "$argc_tool"
  echo "Latest:             $(mise latest "$argc_tool")"
}

# @cmd Resync assets from one or more global tools
# @arg tools+ Tools to resync
sync() {
  mise run system-install "${argc_tools[@]}"
}

declared() {
  mise config get --file "$1" "tools.$2" &>/dev/null
}

# argc-generated variables
declare argc_lsp
declare argc_installed
declare argc_name
declare argc_tool
declare -a argc_tools
eval "$(argc --argc-eval "$0" "$@")"
