#!/usr/bin/env bash
# @describe Manage global tools with an apt-like interface.
set -euo pipefail
[[ "${DEBUG:-}" == "1" ]] && set -x

# Distro tools go to both packages.toml variants; other tools go to tools.toml.
# config.toml is machine-local (docs/adr/0045, docs/adr/0048).
CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/mise
TOOLS_CONFIG=$CONFIG_DIR/conf.d/tools.toml
PACKAGES_MISE=$CONFIG_DIR/conf.d/packages.toml##default
PACKAGES_ARCH=$CONFIG_DIR/conf.d/packages.toml##distro_family.arch

# @cmd Add global tools, or promote ones installed with plain `mise use -g`
# @flag --lsp Install into the global LSP config
# @flag --mise Put new tools in tools.toml even when pacman has them
# @arg tools+ Tool names; use `mise use -g` directly to pin a version locally
install() {
  if [[ "${argc_lsp:-}" == "1" ]]; then
    mise use --global --path "$CONFIG_DIR/conf.d/lsp.toml" "${argc_tools[@]}"
    return
  fi

  local tool
  for tool in "${argc_tools[@]}"; do
    if declared "$TOOLS_CONFIG" "$tool" || declared "$PACKAGES_MISE" "$tool"; then
      echo "tool: $tool is already tracked" >&2
      continue
    fi

    if [[ "${argc_mise:-}" != 1 ]] && is_pacman_package "$tool"; then
      sudo pacman -S --needed --noconfirm "$tool"
      local key=$tool
      [[ $tool =~ ^[A-Za-z0-9_-]+$ ]] || key="\"$tool\""
      set_latest "$PACKAGES_MISE" "tools.$tool" "$key"
      set_latest "$PACKAGES_ARCH" "bootstrap.packages.pacman:$tool" "\"pacman:$tool\""
    else
      mise use --global --path "$TOOLS_CONFIG" "$tool"
    fi
    # Drops it from config.toml, if plain `mise use -g` put it there
    mise unuse --global --no-prune "$tool"
  done
  mise run system-install --only-prune
}

# @cmd Upgrade all or specific installed tools
# @arg tools* Tools to upgrade
upgrade() {
  mise upgrade "${argc_tools[@]}" --bump
}

# @cmd Set up an alias for a tool
# @arg name! Alias name
# @arg tool! Tool
alias() {
  # tool-alias set has no --path; it always writes to the global config file
  MISE_GLOBAL_CONFIG_FILE="$TOOLS_CONFIG" mise tool-alias set "$argc_name" "$argc_tool"
}

# @cmd Remove one or more global tools
# @arg tools+ Tool names; versioned specifications are unsupported
remove() {
  local tool package
  for tool in "${argc_tools[@]}"; do
    if is_pacman_tool "$tool"; then
      package=$(pacman_package "$tool")
      if command -v pacman &>/dev/null; then
        sudo pacman -R --noconfirm "$package"
      fi
      # mise has no command to drop a [bootstrap.packages] entry.
      sed -i "\|^\"pacman:$package\" = |d" "$PACKAGES_ARCH"
    fi
    if declared "$TOOLS_CONFIG" "$tool"; then
      mise unuse --path "$TOOLS_CONFIG" "$tool"
    fi
    if declared "$PACKAGES_MISE" "$tool"; then
      if mise unuse --path "$PACKAGES_MISE" "$tool" 2>/dev/null; then
        fallback_obsolete
      elif grep -qxF "$tool = \"latest\"" "$PACKAGES_MISE"; then
        sed -i "/^$tool = \"latest\"\$/d" "$PACKAGES_MISE"
      else
        echo "tool: remove $tool from $PACKAGES_MISE by hand" >&2
      fi
    fi
  done
  mise run system-install --only-prune
}

# @cmd Search for tools, or list installed global tools
# @flag --installed List installed global tools
# @arg tools* Tools to search for or list
list() {
  if [[ "${argc_installed:-}" == "1" ]]; then
    mise list --global "${argc_tools[@]}"
  else
    mise search "${argc_tools[@]}"
  fi
}

# @cmd Show details about a specific tool
# @arg tool! Tool
show() {
  mise tool "$argc_tool"
  echo "Latest:             $(mise latest "$argc_tool")"
}

# @cmd Resync assets from one or more global tools
# @arg tools+ Tools to resync
sync() {
  mise run system-install "${argc_tools[@]}"
}

# mise config set and unuse reject ## names (docs/BACKLOG.md): fall back to
# editing the variant, whose only table ends the file, and say when mise stops
# failing so the fallback can go
set_latest() {
  if mise config set --file "$1" "$2" latest 2>/dev/null; then
    fallback_obsolete
  else
    printf '%s = "latest"\n' "$3" >>"$1"
  fi
}

fallback_obsolete() {
  echo "tool: mise now edits ## files; drop the fallback in ~/bin/tool" >&2
}

declared() {
  mise config get --file "$1" "tools.$2" &>/dev/null
}

is_pacman_package() {
  [[ $1 =~ ^[A-Za-z0-9_.+-]+$ ]] || return 1
  command -v pacman &>/dev/null || return 1
  pacman -Si "$1" &>/dev/null
}

is_pacman_tool() {
  local package
  [[ $1 =~ ^[A-Za-z0-9_.+-]+$ ]] || return 1
  package=$(pacman_package "$1")
  mise config get --file "$PACKAGES_ARCH" "bootstrap.packages.pacman:$package" &>/dev/null
}

pacman_package() {
  mise config get --file "$PACKAGES_MISE" "tools.$1.pacman" 2>/dev/null || echo "$1"
}

# argc-generated variables
declare argc_lsp
declare argc_mise
declare argc_installed
declare argc_name
declare argc_tool
declare -a argc_tools
eval "$(argc --argc-eval "$0" "$@")"
