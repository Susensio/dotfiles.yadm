#!/usr/bin/env bash
# @describe Manage global tools using mise with an apt-like interface.
set -euo pipefail
[[ "${DEBUG:-}" == "1" ]] && set -x

# @cmd Install one or more global tools
# @flag --lsp Install into the global LSP config
# @arg tools+ Tool specifications, optionally including a version
install() {
  if [[ "$argc_lsp" == "1" ]]; then
    local lsp_config=${XDG_CONFIG_HOME:-$HOME/.config}/mise/conf.d/lsp.toml
    mise use --global --path "$lsp_config" "${argc_tools[@]}"
  else
    mise use --global "${argc_tools[@]}"
  fi
}

# @cmd Upgrade all or specific installed tools
# @arg tools* Tools to upgrade
upgrade() {
  mise upgrade "${argc_tools[@]}" --bump
}

# @cmd Set up an alias for a tool
# @arg name! Alias name
# @arg tool! Tool
alias() {
  mise tool-alias set "$argc_name" "$argc_tool"
}

# @cmd Remove one or more global tools
# @arg tools+ Tools to remove
remove() {
  mise unuse --global "${argc_tools[@]}"
  mise run system-install --only-prune
}

# @cmd Search for tools, or list installed global tools
# @flag --installed List installed global tools
# @arg tools* Tools to upgrade
list() {
  if [[ "$argc_installed" == "1" ]]; then
    mise list --global "${argc_tools[@]}"
  else
    mise search "${argc_tools[@]}"
  fi
}

# @cmd Show details about a specific tool
# @arg tool! Tool
show() {
  mise tool "$argc_tool"
  echo "Latest:             $(mise latest "$argc_tool")"
}

# argc-generated variables
declare argc_lsp
declare argc_installed
declare argc_name
declare argc_tool
declare -a argc_tools
eval "$(argc --argc-eval "$0" "$@")"
