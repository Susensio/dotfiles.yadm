#!/usr/bin/env bash
# Wraps mise to install global tools with apt interface
set -euo pipefail
[[ "${DEBUG:-}" == "1" ]] && set -x

install() {
  mise use --global "$@"
}

upgrade() {
  mise upgrade "$@" --bump
}

alias() {
  mise tool-alias set "$@"
}

remove() {
  mise unuse --global "$@"
  mise run system-install --only-prune
}

list() {
  if [[ "${1:-}" == "--installed" ]]; then
    mise list --global "$@"
  else
    mise search "$@"
  fi
}

show() {
  mise tool "$@"
  echo "Latest:             $(mise latest "$@")"
}

usage() {
  cat <<EOF
Usage: $(basename "$0") COMMAND [ARGS...]

Manage global tools using mise with an apt-like interface.

Commands:
  install [TOOL@VER]...      Install one or more global tools
  remove  [TOOL]...          Remove one or more global tools
  upgrade [TOOL]...          Upgrade all or specific installed packages
  alias   [NAME] [TOOL]      Set up an alias for a given tool
  list [--installed] [TOOL]  Search for tools, or list installed global tools
  show    [TOOL]             Show details about a specific tool

Options:
  -h, --help                 Display this help and exit
EOF
}

main() {
  local cmd=${1:-}
  shift || true

  case "$cmd" in
    install) install "$@" ;;
    upgrade) upgrade "$@" ;;
    remove) remove "$@" ;;
    alias) alias "$@" ;;
    list) list "$@" ;;
    show) show "$@" ;;
    -h | --help) usage ;;
    *) usage exit 1 ;;
  esac
}

main "$@"
