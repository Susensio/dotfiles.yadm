#!/usr/bin/env bash
# Track a secret file encrypted by git-crypt (docs/plans/secrets.md): `yadm add-secret <file>`
# in the dotfiles, `git add-secret <file>` in any other repository that uses git-crypt.
# yadm passes unknown commands to git with GIT_DIR and GIT_WORK_TREE set, and git runs
# git-<name> from PATH, so plain git here acts on whichever repository called it.
# Marks the file in the .gitattributes beside it before staging it, so git-crypt's filter
# applies on add, checks the staged copy is ciphertext, and commits both together.
# Pushing is left to the caller.
set -euo pipefail

die() { printf 'add-secret: %s\n' "$*" >&2; exit 1; }
# git-crypt's ciphertext starts with a NUL, GITCRYPT and a NUL; bash strings cannot hold NUL
is_ciphertext() { [[ $(git cat-file -p "$1" 2> /dev/null | head -c 9 | tail -c 8) == GITCRYPT ]]; }

(( $# == 1 )) || die "usage: yadm add-secret <file>, or git add-secret <file>"
command -v git-crypt &> /dev/null || die "git-crypt is not installed"

work=$(git rev-parse --show-toplevel)
repo=$(git rev-parse --absolute-git-dir)
[[ -d $repo/git-crypt ]] || die "git-crypt is not initialised in $work"

file=$(realpath -s "$1")
[[ -f $file ]] || die "$1: no such file"
[[ $file == "$work"/* ]] || die "$1: not under $work"
rel=${file#"$work"/}
dir=$(dirname "$file")
name=$(basename "$file")

# A plain copy already in history is public for good: encrypting from now on would hide nothing
if [[ -n $(git log --format=%h -1 -- "$file") ]] \
  && ! is_ciphertext "HEAD:$rel"; then
  die "$rel is already committed in plain; rotate the secret, then remove it from history before encrypting it"
fi

attrs=$dir/.gitattributes
line="$name filter=git-crypt diff=git-crypt"
grep -qxF "$line" "$attrs" 2> /dev/null || printf '%s\n' "$line" >> "$attrs"

# Drop a .gitignore line beside it that names the file, the usual way a secret was kept out
paths=("$attrs" "$file")
ignore=$dir/.gitignore
if [[ -f $ignore ]] && grep -qxE "/?${name//./\\.}" "$ignore"; then
  sed -i -E "\\#^/?${name//./\\.}\$#d" "$ignore"
  paths+=("$ignore")
fi
if git check-ignore -q -- "$file"; then
  die "$rel is still ignored by: $(git check-ignore -v -- "$file" | cut -f1); unignore it, then rerun"
fi

git add -- "${paths[@]}"

# A plain git commit skips yadm's pre_commit hook, so the check is made here before committing
if ! is_ciphertext ":$rel" || ! git crypt status -e > /dev/null 2>&1; then
  git reset -q -- "$file"
  die "$rel did not stage encrypted; it is unstaged again and nothing was committed"
fi

area=${rel#.config/}
area=${area#stacks/}
area=${area%%/*}
git commit -q -m "$area: track $name, encrypted with git-crypt" -- "${paths[@]}"
printf 'add-secret: committed %s encrypted; push to publish\n' "$rel"
