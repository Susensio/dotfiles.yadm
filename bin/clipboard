#!/usr/bin/env bash
# @describe Clipboard, platform agnostic
# @option -s --selection[=clipboard|primary] Clipboard selection
# @meta inherit-flag-options

set -euo pipefail

FALLBACK_FILE="${XDG_RUNTIME_DIR:-/tmp}/clipboard_${USER:-shared}"

get_system() {
  # Over SSH the host's own clipboard isn't the user's; OSC 52 reaches their terminal.
  if [[ -n "${SSH_CONNECTION:-}" ]]; then
    echo "osc52"
  elif uname -r | grep -q -i "microsoft"; then
    echo "wsl"
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    echo "macos"
  elif [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
    echo "wayland"
  elif [[ -n "${DISPLAY:-}" ]]; then
    echo "x11"
  elif [[ -n "${TMUX:-}" ]]; then
    echo "tmux"
  else
    echo "fallback"
  fi
}

save_fallback() {
  rm -f "$FALLBACK_FILE"
  cat > "$FALLBACK_FILE"
  chmod 600 "$FALLBACK_FILE"
}

copy_to_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [[ "$argc_selection" == "clipboard" ]]; then
        wl-copy
      else
        wl-copy --primary
      fi
      ;;
    x11)
      xsel -i --"$argc_selection"
      ;;
    wsl)
      /mnt/c/Windows/System32/clip.exe
      ;;
    macos)
      pbcopy
      ;;
    tmux)
      tmux load-buffer -w -
      ;;
    osc52)
      # tmux -w wraps OSC 52 itself; outside tmux write it to the terminal, keeping a local copy for paste.
      if [[ -n "${TMUX:-}" ]]; then
        tmux load-buffer -w -
      else
        local data sel=c
        data=$(cat)
        [[ "$argc_selection" == "primary" ]] && sel=p
        printf '\e]52;%s;%s\a' "$sel" "$(printf %s "$data" | base64 -w0)" > /dev/tty
        printf %s "$data" | save_fallback
      fi
      ;;
    fallback)
      save_fallback
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

paste_from_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [[ "$argc_selection" == "clipboard" ]]; then
        wl-paste --no-newline
      else
        wl-paste --primary --no-newline
      fi
      ;;
    x11)
      xsel -o --"$argc_selection"
      ;;
    wsl)
      powershell.exe -noprofile -c '[Console]::Out.Write($(Get-Clipboard -Raw).tostring().replace("`r", ""))'
      ;;
    macos)
      pbpaste
      ;;
    tmux)
      tmux save-buffer -
      ;;
    osc52)
      # OSC 52 is write-only here; paste what this host last copied.
      if [[ -n "${TMUX:-}" ]]; then
        tmux save-buffer -
      elif [[ -f "$FALLBACK_FILE" ]]; then
        cat "$FALLBACK_FILE"
      fi
      ;;
    fallback)
      if [[ -f "$FALLBACK_FILE" ]]; then
        cat "$FALLBACK_FILE"
      fi
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

# @cmd Copy stdin to the clipboard
copy() {
  copy_to_clipboard
}

# @cmd Paste the clipboard to stdout
paste() {
  paste_from_clipboard
}

# @cmd Copy stdin if piped, otherwise paste to stdout
# @meta default-subcommand
pipe() {
  if [[ -p /dev/stdin ]]; then
    copy_to_clipboard
  else
    paste_from_clipboard
  fi
}

declare argc_selection
eval "$(argc --argc-eval "$0" "$@")"
