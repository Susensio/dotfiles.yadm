#!/bin/bash
# Clipboard, platform agnostic

MODE="pipe"
SELECTION="clipboard"
DISPLAY="${DISPLAY:-:0}"
export DISPLAY
FALLBACK_FILE="${XDG_RUNTIME_DIR:-/tmp}/clipboard_${USER:-shared}"

get_system() {
  if uname -r | grep -q -i "microsoft"; then
    echo "wsl"
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    echo "macos"
  elif [[ "$XDG_SESSION_TYPE" == "wayland" ]]; then
    echo "wayland"
  elif [[ "$XDG_SESSION_TYPE" == "x11" ]] || [[ -n "$DISPLAY" ]]; then
    echo "x11"
  elif [[ -n "$TMUX" ]]; then
    echo "tmux"
  else
    echo "fallback"
  fi
}

# Copying function
copy_to_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [ "$SELECTION" == "clipboard" ]; then
        wl-copy
      else
        wl-copy --primary
      fi
      ;;
    x11)
      xsel -i --"$SELECTION"
      ;;
    wsl)
      /mnt/c/Windows/System32/clip.exe
      ;;
    macos)
      pbcopy
      ;;
    tmux)
      tmux load-buffer -
      ;;
    fallback)
      rm -f "$FALLBACK_FILE"
      cat > "$FALLBACK_FILE"
      chmod 600 "$FALLBACK_FILE"
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

# Pasting function
paste_from_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [ "$SELECTION" == "clipboard" ]; then
        wl-paste --no-newline
      else
        wl-paste --primary --no-newline
      fi
      ;;
    x11)
      xsel -o --"$SELECTION"
      ;;
    wsl)
      powershell.exe -noprofile -c '[Console]::Out.Write($(Get-Clipboard -Raw).tostring().replace("`r", ""))'
      ;;
    macos)
      pbpaste
      ;;
    tmux)
      tmux save-buffer -
      ;;
    fallback)
      if [[ -f "$FALLBACK_FILE" ]]; then
        cat "$FALLBACK_FILE"
      fi
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

# Parse command line arguments
while [[ "$#" -gt 0 ]]; do
  case $1 in
    copy | paste)
      MODE=$1
      shift
      ;;
    -s | --selection)
      shift
      case "$1" in
        "clipboard" | "primary")
          SELECTION="$1"
          ;;
        *)
          echo "Invalid selection value: $1. Allowed values are 'clipboard' or 'primary'."
          exit 1
          ;;
      esac
      shift
      ;;
    *)
      echo "Unknown argument: $1"
      exit 1
      ;;
  esac
done

case $MODE in
  copy)
    copy_to_clipboard
    ;;
  paste)
    paste_from_clipboard
    ;;
  pipe)

    if [[ -p /dev/stdin ]]; then
      copy_to_clipboard
    else
      paste_from_clipboard
    fi
    ;;
  *)
    echo "ERROR: No command provided" >&2
    exit 1
    ;;
esac
