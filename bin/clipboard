#!/usr/bin/env bash
# @describe Clipboard, platform agnostic
# @option -s --selection[=clipboard|primary] Clipboard selection
# @meta inherit-flag-options

set -euo pipefail

DISPLAY="${DISPLAY:-:0}"
export DISPLAY
FALLBACK_FILE="${XDG_RUNTIME_DIR:-/tmp}/clipboard_${USER:-shared}"

get_system() {
  if uname -r | grep -q -i "microsoft"; then
    echo "wsl"
  elif [[ "$OSTYPE" == "darwin"* ]]; then
    echo "macos"
  elif [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
    echo "wayland"
  elif [[ "${XDG_SESSION_TYPE:-}" == "x11" ]] || [[ -n "$DISPLAY" ]]; then
    echo "x11"
  elif [[ -n "${TMUX:-}" ]]; then
    echo "tmux"
  else
    echo "fallback"
  fi
}

copy_to_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [[ "$argc_selection" == "clipboard" ]]; then
        wl-copy
      else
        wl-copy --primary
      fi
      ;;
    x11)
      xsel -i --"$argc_selection"
      ;;
    wsl)
      /mnt/c/Windows/System32/clip.exe
      ;;
    macos)
      pbcopy
      ;;
    tmux)
      tmux load-buffer -
      ;;
    fallback)
      rm -f "$FALLBACK_FILE"
      cat > "$FALLBACK_FILE"
      chmod 600 "$FALLBACK_FILE"
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

paste_from_clipboard() {
  local system
  system=$(get_system)

  case "$system" in
    wayland)
      if [[ "$argc_selection" == "clipboard" ]]; then
        wl-paste --no-newline
      else
        wl-paste --primary --no-newline
      fi
      ;;
    x11)
      xsel -o --"$argc_selection"
      ;;
    wsl)
      powershell.exe -noprofile -c '[Console]::Out.Write($(Get-Clipboard -Raw).tostring().replace("`r", ""))'
      ;;
    macos)
      pbpaste
      ;;
    tmux)
      tmux save-buffer -
      ;;
    fallback)
      if [[ -f "$FALLBACK_FILE" ]]; then
        cat "$FALLBACK_FILE"
      fi
      ;;
    *)
      echo "Error: Unsupported or unknown system: $system" >&2
      exit 1
      ;;
  esac
}

# @cmd Copy stdin to the clipboard
copy() {
  copy_to_clipboard
}

# @cmd Paste the clipboard to stdout
paste() {
  paste_from_clipboard
}

# @cmd Copy stdin if piped, otherwise paste to stdout
# @meta default-subcommand
pipe() {
  if [[ -p /dev/stdin ]]; then
    copy_to_clipboard
  else
    paste_from_clipboard
  fi
}

declare argc_selection
eval "$(argc --argc-eval "$0" "$@")"
