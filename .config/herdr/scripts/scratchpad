#!/usr/bin/env bash
set -euo pipefail
[[ "${DEBUG:-}" == "1" ]] && { exec 2>>/tmp/herdr-scratchpad.env.log; env | grep '^HERDR' >>/tmp/herdr-scratchpad.env.log; }
unset TMUX TMUX_PANE

# Strict mirror of the tmux-native scratchpad (ADR-0015): one shared server
# on a `_scratchpad`-suffixed socket (so the native guard in
# conf.d/50_scratchpad.conf recognizes it), one session per herdr
# workspace. The mapping key is the workspace ID, which herdr guarantees
# never to reuse - so a session name permanently identifies its workspace,
# dead or alive, and orphaned sessions stay unambiguous.
#
# Caller context: popup commands receive the HERDR_ACTIVE_* set and no
# HERDR_PANE_ID; pane children receive HERDR_WORKSPACE_ID. Keys are never
# re-resolvable later (popup env is fixed at launch), so only inherited
# caller context counts.
WK_ID="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"

if [[ -z "$WK_ID" ]]; then
  pane_id="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
  if [[ -n "$pane_id" ]]; then
    WK_ID=$(herdr pane get "$pane_id" 2>/dev/null | jq -r '.result.pane.workspace_id // empty')
  fi
fi

if [[ -z "$WK_ID" ]]; then
  echo "scratchpad: no caller context (run via herdr alt+\`, not a plain shell)" >&2
  exit 1
fi

# Shim lives next to this script and sources tmux's own
# conf.d/50_scratchpad.conf (chrome off, detach handling) without the main
# config's plugins and key surface.
SCRATCH_CONF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/scratchpad.tmux.conf"
[[ -r "$SCRATCH_CONF" ]] || { echo "scratchpad: missing helper config $SCRATCH_CONF" >&2; exit 1; }

# The `_scratchpad` suffix is load-bearing: the tmux-native guard keys on
# #{b:socket_path}, and it is the pairing convention ADR-0015 established.
SOCK="herdr_scratchpad"

# Session per workspace, addressed ONLY by exact match: tmux target
# resolution falls back to prefix and glob matching, and herdr IDs like
# "w5" would otherwise reach a session named "w50". The "=" prefix
# disables those fallbacks, mirroring the tmux-native script's own guards.
SESSION_TARGET="=$WK_ID"
BASE=(tmux -L "$SOCK" -f "$SCRATCH_CONF")

# Create-once, attach-always: one session per workspace holds window
# "main". Without an argument the session runs the login shell (fish, per
# the shim); with one, the first window runs that command. Either way the
# session - not the window - is the durable thing the popup re-attaches to.
if ! "${BASE[@]}" has -t "$SESSION_TARGET" 2>/dev/null; then
  if [[ $# -gt 0 ]]; then
    "${BASE[@]}" new-session -d -s "$WK_ID" -n main "$@"
  else
    "${BASE[@]}" new-session -d -s "$WK_ID" -n main
  fi
fi
exec "${BASE[@]}" attach -t "$SESSION_TARGET"
