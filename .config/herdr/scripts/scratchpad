#!/usr/bin/env bash
set -e

# Unset TMUX to avoid nesting issues
unset TMUX
unset TMUX_PANE

CMD="${1:-}"
WORKSPACE_ID="$(herdr pane get "$HERDR_ACTIVE_PANE_ID" | jq -r '.result.workspace_id')"

if [ -z "$CMD" ]; then
    # No command provided, let tmux launch the default shell
    exec tmux -L herdr_scratchpad new-session -A -s "$WORKSPACE_ID"
else
    # Command provided, run it in the session
    exec tmux -L herdr_scratchpad new-session -A -s "$WORKSPACE_ID" "$CMD"
fi
