#!/usr/bin/env bash
set -euo pipefail
# Herdr never reuses workspace IDs, so each scratch session has a stable owner.
# Caller context: popup commands receive the HERDR_ACTIVE_* set and no
# HERDR_PANE_ID; pane children receive HERDR_WORKSPACE_ID. Keys are never
# re-resolvable later (popup env is fixed at launch), so only inherited
# caller context counts.
WK_ID="${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}"

if [[ -z "$WK_ID" ]]; then
  pane_id="${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}"
  if [[ -n "$pane_id" ]]; then
    WK_ID=$(herdr pane get "$pane_id" 2>/dev/null | jq -r '.result.pane.workspace_id // empty')
  fi
fi

if [[ -z "$WK_ID" ]]; then
  echo "scratchpad: no caller context (run via herdr alt+\`, not a plain shell)" >&2
  exit 1
fi

SCRATCH_CONF="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/scratchpad.toml"
[[ -r "$SCRATCH_CONF" ]] || { echo "scratchpad: missing config $SCRATCH_CONF" >&2; exit 1; }

# Herdr launches popup commands from the workspace root directory. Use that as
# the scratch start directory, with fallbacks in case it ever changes.
START_CWD="$PWD"
[[ -n "$START_CWD" && -d "$START_CWD" ]] || START_CWD="${HERDR_ACTIVE_PANE_CWD:-}"
[[ -n "$START_CWD" && -d "$START_CWD" ]] || START_CWD="$HOME"

# cd before exec so the inner herdr creates its startup workspace here.
# Do not route the nested client back to the outer server's socket or session.
# stderr only carries the shutdown notice from scratchpad-shell, which the popup
# closes too fast to read; silence it so the close looks clean.
cd "$START_CWD" 2>/dev/null || cd "$HOME" || true
exec env -u HERDR_SOCKET_PATH -u HERDR_SESSION \
  -u HERDR_ACTIVE_WORKSPACE_ID -u HERDR_ACTIVE_TAB_ID -u HERDR_ACTIVE_PANE_ID -u HERDR_ACTIVE_PANE_CWD \
  -u HERDR_WORKSPACE_ID -u HERDR_TAB_ID -u HERDR_PANE_ID \
  HERDR_CONFIG_PATH="$SCRATCH_CONF" \
  herdr --session "scratchpad-$WK_ID" 2>/dev/null
