#!/usr/bin/env bash
# Keeps herdr's Claude detection override = herdr's current Claude rules + one rule that shows the pane as waiting
# while asroot's sudo popup is open (docs/adr/0139-asroot-popup-marks-agent-waiting.md).
# Run from Claude's SessionStart hook; reloads herdr only when the result changed,
# because a reload drops every agent pane to "unknown" until its screen next changes.
set -u

tag="# Generated by herdr/scripts/claude-rules from herdr's cached Claude rules; edits are overwritten."
rules="${XDG_STATE_HOME:-$HOME/.local/state}/herdr/agent-detection/remote/claude.toml"
override="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/agent-detection/claude.toml"
herdr="${HERDR_BIN_PATH:-}"
[[ -x "$herdr" ]] || herdr="$(command -v herdr)" || exit 0
[[ -r "$rules" ]] || exit 0
# A hand-written override wins; herdr merges nothing, so this one would replace it.
[[ -e "$override" && "$(head -n1 "$override")" != "$tag" ]] && exit 0

new="$(awk -v tag="$tag" '
  NR == 1 { print tag }
  /^\[\[rules\]\]/ && !done {
    print "[[rules]]"
    print "id = \"asroot_sudo_popup\""
    print "state = \"blocked\""
    # Above osc_title_working (1100): Claude is mid-tool while the popup is open, so its title spins.
    print "priority = 1200"
    print "region = \"after_last_horizontal_rule\""
    print "visible_blocker = true"
    # Printed by claude/statusline-refresh.sh; keep the two in step.
    print "contains = [\"asroot: password in the sudo popup\"]"
    print ""
    done = 1
  }
  { print }' "$rules")"

[[ "$new" == "$(cat "$override" 2>/dev/null)" ]] && exit 0
mkdir -p "${override%/*}"
printf '%s\n' "$new" >"$override.tmp" && mv "$override.tmp" "$override" &&
  "$herdr" server reload-agent-manifests >/dev/null 2>&1
exit 0
