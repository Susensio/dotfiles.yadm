#!/usr/bin/env bash
# Herdr replaces a closed last workspace instead of exiting, so a scratch shell
# that exits stops its own session; the attached client then closes the popup.
/usr/bin/fish "$@" || :
# With saved machines the client survives a stopped server ("Local reconnecting"), so end it too.
[[ -n "${HERDR_SESSION:-}" ]] && pkill -f -- "herdr --session ${HERDR_SESSION}\$" || :
exec "${HERDR_BIN_PATH:-herdr}" server stop >/dev/null 2>&1
