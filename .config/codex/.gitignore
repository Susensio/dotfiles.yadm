# Hand-maintained config only; runtime state stays local.
*
!.gitignore
!AGENTS.md
!config.toml
!hooks.json
!herdr-agent-state.sh
!rules/
!rules/**
!skills/
!skills/**

# Bundled skills are managed by Codex.
skills/.system/
# Omarchy's skills, which omarchy/skills.sh links in. No trailing slash: to git
# a symlink is a file, not a directory.
skills/omarchy
skills/diagnose-crash
__pycache__/
*.pyc
