# Hand-maintained config only; runtime state stays local.
*
!.gitignore
!AGENTS.md
!config.toml
!hooks.json
!herdr-agent-state.sh
!rules/
!rules/**
!skills/
!skills/**

# Bundled skills are managed by Codex.
skills/.system/
# Linked in by the bootstrap; a symlink takes no trailing slash.
skills/omarchy
skills/diagnose-crash
skills/herdr/
__pycache__/
*.pyc
