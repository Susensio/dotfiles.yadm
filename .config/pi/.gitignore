# Hand-maintained config only; docs in README.md.
*
!.gitignore
!README.md
!agent/
!agent/AGENTS.md
!agent/README.md
!agent/settings.json
!agent/subagents.json
!agent/agents/
!agent/agents/**
!agent/skills/
!agent/skills/**
!agent/extensions/
!agent/extensions/**

# Knockouts last: the last matching rule wins.
node_modules/
__pycache__/
*.pyc
agent/extensions/**/logs/
# Omarchy-linked; no trailing slash: a symlink is a file, not a directory.
agent/skills/omarchy
agent/skills/diagnose-crash
