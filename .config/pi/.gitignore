# Hand-maintained config only; docs in README.md.
*
!.gitignore
!README.md
!agent/
!agent/AGENTS.md
!agent/README.md
!agent/settings.json
!agent/keybindings.json
!agent/subagents.json
!agent/models.json
!agent/model-alias.json
!agent/cycled-models.json
!agent/always-ask.json
!agent/claude-bridge.json
!agent/agents/
!agent/agents/**
!agent/skills/
!agent/skills/**
!agent/prompts/
!agent/prompts/**
!agent/extensions/
!agent/extensions/**
!agent/patches/
!agent/patches/**
!agent/bundler/
!agent/bundler/**

# Knockouts last: the last matching rule wins.
node_modules/
__pycache__/
*.pyc
agent/extensions/**/logs/
# Omarchy-linked; no trailing slash: a symlink is a file, not a directory.
agent/skills/omarchy
agent/skills/diagnose-crash
agent/skills/herdr/
