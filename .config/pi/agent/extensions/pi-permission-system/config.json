{
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": false,
  "piInfrastructureReadPaths": [],
  "authorizerChain": [
    "session-yolo",
    "always-ask",
    "auto-review"
  ],
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "~/.config/google-chrome/*": "ask",
      "~/.config/chromium/*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.keyring": "deny",
      "*auth.json": "deny",
      "~/.ssh/*": "deny",
      "~/.gnupg/*": "deny",
      "~/.local/share/gnupg/*": "deny",
      "~/.config/gh/*": "deny",
      "*.envrc": "deny",
      "~/.local/share/keyrings/*": "deny",
      "~/.aws/*": "deny",
      "~/.netrc": "deny",
      "~/.git-credentials": "deny",
      "~/.config/gcloud/*": "deny",
      "~/.kube/config": "deny",
      "~/.docker/config.json": "deny"
    },
    "path_write": {
      "~/.config/pi/agent/extensions/pi-permission-system/config.json": "ask"
    },
    "external_directory": {
      "*": "ask",
      "~/.config/*": "allow",
      "~/.local/*": "allow",
      "~/Projects/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "*": "ask",
      "~": "allow",
      "~/*": "allow",
      "/tmp": "allow",
      "/tmp/*": "allow",
      "/usr": "allow",
      "/usr/*": "allow",
      "/etc": "allow",
      "/etc/*": "allow",
      "/opt": "allow",
      "/opt/*": "allow",
      "/home": "allow",
      "/sys/class/power_supply/*": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "yadm status*": "allow",
      "yadm diff*": "allow",
      "yadm list*": "allow",
      "yadm add*": "allow",
      "git add*": "allow",
      "rg*": "allow",
      "ls*": "allow",
      "which *": "allow",
      "rm /tmp/*": "allow",
      "rm -f /tmp/*": "allow",
      "herdr api*": "allow",
      "herdr --session* pane read*": "allow",
      "strings *": "allow",
      "rm -rf /tmp/*": "allow",
      "set -eu": "allow",
      "sudo *": {
        "action": "deny",
        "reason": "Use pkexec for privileged commands; it opens the desktop fingerprint authentication dialog."
      },
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "sed -n *": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "yadm alt*": "allow",
      "grep *": "allow",
      "cd *": "allow",
      "printf *": "allow",
      "echo *": "allow",
      "true": "allow",
      "node --version*": "allow",
      "git reset *": "ask",
      "yadm reset *": "ask",
      "git checkout *": "ask",
      "yadm checkout *": "ask",
      "git restore *": "ask",
      "yadm restore *": "ask",
      "git clean *": "ask",
      "yadm clean *": "ask",
      "git stash *": "ask",
      "yadm stash *": "ask",
      "pkexec *": "ask",
      "* pkexec *": "ask"
    },
    "skill": "allow",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "todo": "allow",
    "ask_user_question": "allow",
    "web_fetch": "allow",
    "web_search": "allow"
  }
}
