{
  "providers": {
    "openai-codex": {
      "models": [
        {
          "$comment": "Hidden model the auto-reviewer synthesizes ad hoc; registered so alias/reviewer can target it.",
          "id": "codex-auto-review",
          "name": "Codex Auto Review",
          "api": "openai-codex-responses",
          "reasoning": true,
          "input": ["text"]
        }
      ]
    },
    "opencode-go": {
      "apiKey": "!$PI_CODING_AGENT_DIR/bin/env-key OPENCODE_API_KEY",
      "$comment": "Kimi K2.7 Code always thinks and does not support reasoning_effort (only K3 does); mirror Moonshot AI's own catalog entry so pi sends the thinking object, never reasoning_effort or thinking:disabled.",
      "modelOverrides": {
        "kimi-k2.7-code": {
          "thinkingLevelMap": { "off": null },
          "compat": {
            "thinkingFormat": "deepseek",
            "supportsReasoningEffort": false
          }
        }
      }
    },
    "google": {
      "apiKey": "!$PI_CODING_AGENT_DIR/bin/env-key GEMINI_API_KEY"
    },
    "groq": {
      "apiKey": "!$PI_CODING_AGENT_DIR/bin/env-key GROQ_API_KEY"
    },
    "mistral": {
      "apiKey": "!$PI_CODING_AGENT_DIR/bin/env-key MISTRAL_API_KEY"
    }
  }
}
