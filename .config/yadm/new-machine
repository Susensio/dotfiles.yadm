#!/usr/bin/env bash
# Set up a new machine: install curl and git, clone this repository over any
# file in the way, run `yadm bootstrap` (with the logins in between at a
# terminal), and leave yadm usable in this shell.
# Source it (a `bash <(...)` run does the same without the yadm function):
#   source <(curl -fsSL https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/.config/yadm/new-machine)
# Needs curl or wget to fetch itself.

# The master URLs are defaults; CI points both at the branch under test. Not
# REPO_URL: bootstrap.yadm.io, sourced below, sets that one to empty.
NM_REPO=${NEW_MACHINE_REPO_URL:-https://github.com/Susensio/dotfiles.yadm.git}
NM_RAW=${NEW_MACHINE_RAW_URL:-https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master}

# A subshell, so set -e never reaches the shell this is sourced in
(
  set -euo pipefail

  missing=()
  for tool in curl git; do
    command -v "$tool" &> /dev/null || missing+=("$tool")
  done
  if ((${#missing[@]})); then
    installer=$(mktemp)
    if command -v curl &> /dev/null; then
      curl -fsSL "$NM_RAW/bin/pkg-install" > "$installer"
    else
      wget -qO "$installer" "$NM_RAW/bin/pkg-install"
    fi
    bash "$installer" "${missing[@]}"
  fi
) || return 1

# Defines yadm(), remote until the permanent one is installed; subshells inherit it
source <(curl -fsSL https://bootstrap.yadm.io) || return 1

# Not `yadm introspect repo`: the remote function warns on stdout
(
  set -euo pipefail

  if [[ ! -d ${XDG_DATA_HOME:-$HOME/.local/share}/yadm/repo.git ]]; then
    yadm clone --no-bootstrap ${NEW_MACHINE_BRANCH:+-b "$NEW_MACHINE_BRANCH"} "$NM_REPO"
    yadm checkout -- "$HOME"
  fi
  yadm bootstrap
) || return 1

# Logins a bootstrap step never starts (ADR-0111), run here because a person is
# at the terminal; a phone or any signed-in machine approves them (docs/adr/0115).
if [[ -t 0 && -t 1 ]]; then
  (
    set -euo pipefail

    # environment.d applies only from the next login, as in the bootstrap
    set -a
    . "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/10_xdg.conf"
    . "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/11_path.conf"
    set +a

    logged_in=false
    if command -v tailscale &> /dev/null \
      && [[ $(tailscale status --json 2> /dev/null | jq -r .BackendState) == NeedsLogin ]]; then
      echo "Tailscale: approve this login on your phone or a signed-in machine"
      tailscale up --qr --ssh --operator="$USER"
      logged_in=true
    fi

    scope=admin:ssh_signing_key
    if command -v gh &> /dev/null; then
      if ! gh auth status &> /dev/null; then
        echo "GitHub: approve the code at github.com/login/device on your phone or a signed-in machine"
        GH_BROWSER=true gh auth login --hostname github.com --git-protocol https --web --scopes "$scope"
        logged_in=true
      elif ! gh api -i user 2> /dev/null | grep -i '^x-oauth-scopes:' | grep -q "$scope"; then
        echo "GitHub: approve the code at github.com/login/device to add the $scope scope"
        GH_BROWSER=true gh auth refresh --hostname github.com --scopes "$scope"
        logged_in=true
      fi
    fi

    # The vault (docs/plans/vault.md): its GPG key also unlocks this repository's
    # git-crypt. Skipped quietly when the store cannot be cloned, as the logins are.
    VAULT=$HOME/.local/share/secrets
    if [[ ! -d $VAULT ]] && gh repo clone Susensio/secrets "$VAULT" &> /dev/null; then
      echo "Vault: the GPG key asks for the master passphrase"
      gpg --import "$VAULT/vault-key.asc"
      yadm git-crypt unlock
    fi

    # The steps that warned about these logins finish now
    if $logged_in; then yadm bootstrap; fi
  ) || return 1
fi

# The bootstrap links mise's yadm here; a login would put it on PATH
PATH=$HOME/.local/bin:$PATH
