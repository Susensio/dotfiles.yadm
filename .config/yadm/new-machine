#!/usr/bin/env bash
# Set up a new machine: install curl and git, clone this repository over any
# file in the way, run `yadm bootstrap`, and leave yadm usable in this shell.
# Source it (a `bash <(...)` run does the same without the yadm function):
#   source <(curl -fsSL https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/.config/yadm/new-machine)
# Needs curl or wget to fetch itself.

# A subshell, so set -e never reaches the shell this is sourced in
(
  set -euo pipefail

  missing=()
  for tool in curl git; do
    command -v "$tool" &> /dev/null || missing+=("$tool")
  done
  if ((${#missing[@]})); then
    installer=$(mktemp)
    if command -v curl &> /dev/null; then
      curl -fsSL https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/bin/pkg-install > "$installer"
    else
      wget -qO "$installer" https://raw.githubusercontent.com/Susensio/dotfiles.yadm/master/bin/pkg-install
    fi
    bash "$installer" "${missing[@]}"
  fi
) || return 1

# Defines yadm(), remote until the permanent one is installed; subshells inherit it
source <(curl -fsSL https://bootstrap.yadm.io) || return 1

# Not `yadm introspect repo`: the remote function warns on stdout
(
  set -euo pipefail

  if [[ ! -d ${XDG_DATA_HOME:-$HOME/.local/share}/yadm/repo.git ]]; then
    yadm clone --no-bootstrap https://github.com/Susensio/dotfiles.yadm.git
    yadm checkout -- "$HOME"
  fi
  yadm bootstrap
) || return 1

# The bootstrap links mise's yadm here; a login would put it on PATH
PATH=$HOME/.local/bin:$PATH
