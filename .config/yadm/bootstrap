#!/usr/bin/env bash
set -euo pipefail

# environment.d applies only from the next login, so a first bootstrap ran
# without PATH's ~/bin and ~/.local/bin and with tools' default homes (rustup
# in ~/.rustup); its shell-safe files, as in mise/tasks/herdr-integrations
set -a
. "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/10_xdg.conf"
. "${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/11_path.conf"
set +a

# Execute all executable files (excluding yadm alternates) in the
# ~/.config/yadm/bootstrap.d directory when run. Files a step installs live
# under its assets/ directory, non-executable so they never run as steps.
# A ## path is an alternate (ADR-0080): the tracked entry must never run as a
# step, and its directory is reached only through the link where its class holds.
# https://github.com/TheLocehiliosan/yadm/blob/master/contrib/bootstrap/bootstrap-in-dir

# Directory to look for bootstrap executables in
BOOTSTRAP_DIR="${BASH_SOURCE[0]}.d"

mkdir -p "$HOME/Projects"

if [[ ! -d "$BOOTSTRAP_DIR" ]]; then
  log error "Error: bootstrap directory '$BOOTSTRAP_DIR' not found"
  exit 1
fi

scripts=()
readarray -t scripts < <(find -L "$BOOTSTRAP_DIR" -type f -executable ! -path '*##*' | sort)

# Steps print only what they change
for script in "${scripts[@]}"; do
  start=${EPOCHREALTIME//[!0-9]/}
  if ! "$script"; then
    log error "Error: bootstrap $script failed"
    exit 1
  fi
  ms=$(((${EPOCHREALTIME//[!0-9]/} - start) / 1000))
  log debug "$(printf '%6dms %s' "$ms" "${script#"$BOOTSTRAP_DIR"/}")"
done

# environment.d only applies from the next login
login=$(date -d "$(systemctl --user show -P UserspaceTimestamp)" +%s)
for conf in "${XDG_CONFIG_HOME:-$HOME/.config}"/environment.d/*.conf; do
  if (($(stat -c %Y "$conf") > login)); then
    log warn "environment.d changed since login: log out and back in to apply it"
    break
  fi
done
