#!/usr/bin/env bash
set -euo pipefail

# All subsequent commands must have the right environment variables
source "${XDG_CONFIG_HOME:-${HOME}/.config}/profile" || source "${HOME}/.profile"
source "${HOME}/bin/log"

# Execute all executable files (excluding templates and editor backups) in the
# ~/.config/yadm/bootstrap.d directory when run.
# https://github.com/TheLocehiliosan/yadm/blob/master/contrib/bootstrap/bootstrap-in-dir

# Directory to look for bootstrap executables in
BOOTSTRAP_DIR="${BASH_SOURCE[0]}.d"

if [[ ! -d "$BOOTSTRAP_DIR" ]]; then
  log_error "Error: bootstrap directory '$BOOTSTRAP_DIR' not found"
  exit 1
fi

scripts=()
readarray -t scripts < <(find -L "$BOOTSTRAP_DIR" -type f -executable ! -name '*##*' | sort)

for script in "${scripts[@]}"; do
  log_debug "Bootstraping file $script)..."
  if ! "$script"; then
    log_error "Error: bootstrap $script failed"
    exit 1
  fi
done
