+              var step = resultGrid.height / 8
+              var top = resultGrid.originY
+              resultGrid.contentY = Math.max(top, Math.min(
+                resultGrid.contentY - wheel.angleDelta.y / 120.0 * step,
+                top + resultGrid.contentHeight - resultGrid.height))
+              wheel.accepted = true
+            }
+          }
