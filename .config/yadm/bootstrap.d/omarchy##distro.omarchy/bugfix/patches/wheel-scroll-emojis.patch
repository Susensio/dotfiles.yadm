--- a/emojis/Emojis.qml
+++ b/emojis/Emojis.qml
@@ -338,6 +338,23 @@
               width: parent.width
             }
           }
+
+          // Qt's wheel step for a Flickable is fixed; this scrolls an eighth of the
+          // view per notch, and touchpad deltas in proportion. Bounds start at originY,
+          // which sections and delegates laid out above the view move away from 0.
+          MouseArea {
+            anchors.fill: parent
+            acceptedButtons: Qt.NoButton
+            onWheel: function(wheel) {
+              if (wheel.angleDelta.y === 0 || resultGrid.contentHeight <= resultGrid.height) return
+              var step = resultGrid.height / 8
+              var top = resultGrid.originY
+              resultGrid.contentY = Math.max(top, Math.min(
+                resultGrid.contentY - wheel.angleDelta.y / 120.0 * step,
+                top + resultGrid.contentHeight - resultGrid.height))
+              wheel.accepted = true
+            }
+          }
         }
       }
     }
