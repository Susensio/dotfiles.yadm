+          // Qt's wheel step for a Flickable is fixed; this scrolls an eighth of the
+          // view per notch, and touchpad deltas in proportion.
+          MouseArea {
+            anchors.fill: parent
+            acceptedButtons: Qt.NoButton
+            onWheel: function(wheel) {
+              if (wheel.angleDelta.y === 0 || resultList.contentHeight <= resultList.height) return
+              var step = resultList.height / 8
+              resultList.contentY = Math.max(0, Math.min(
+                resultList.contentY - wheel.angleDelta.y / 120.0 * step,
+                resultList.contentHeight - resultList.height))
+              wheel.accepted = true
+            }
+          }
         }
 
