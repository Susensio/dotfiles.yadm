+
+          // Qt's wheel step for a Flickable is fixed; this scrolls an eighth of the
+          // view per notch, and touchpad deltas in proportion. Bounds start at originY,
+          // which sections and delegates laid out above the view move away from 0.
+          MouseArea {
+            anchors.fill: parent
+            acceptedButtons: Qt.NoButton
+            onWheel: function(wheel) {
+              if (wheel.angleDelta.y === 0 || resultList.contentHeight <= resultList.height) return
+              var step = resultList.height / 8
+              var top = resultList.originY
+              resultList.contentY = Math.max(top, Math.min(
+                resultList.contentY - wheel.angleDelta.y / 120.0 * step,
+                top + resultList.contentHeight - resultList.height))
+              wheel.accepted = true
+            }
+          }
         }
 
