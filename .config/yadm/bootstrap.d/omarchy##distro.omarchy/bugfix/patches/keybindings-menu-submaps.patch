 # - Remove standard Omarchy bin path prefix
 # - Map numeric modifier key mask to a textual rendition
 # - Output comma-separated values that the parser can understand
+# Map each submap to the chord that enters it, so its bindings can be listed
+# under that chord. Lua configs report the entry bind as __lua, so read it from
+# the Lua bind cache; hyprland.conf reports dispatcher submap directly.
+build_submap_entry_map() {
+  local cache_key name modmask key modifiers
+
+  add_submap_entry() {
+    [[ -z $1 || $1 == "reset" || -z $3 ]] && return
+    modifiers=$(modmask_to_text "$2")
+    SUBMAP_ENTRY_MAP["$1"]="${modifiers:+${modifiers// / + } + }${3##* + }"
+  }
+
+  for cache_key in "${!LUA_BIND_ARG_MAP[@]}"; do
+    [[ ${LUA_BIND_ARG_MAP["$cache_key"]} =~ ^hl\.dsp\.submap\(\"([^\"]+)\"\)$ ]] || continue
+    add_submap_entry "${BASH_REMATCH[1]}" "${cache_key%%,*}" "${cache_key##*,}"
+  done
+
+  while IFS=$'\x1f' read -r modmask key name; do
+    add_submap_entry "$name" "$modmask" "$key"
+  done < <(
+    hyprctl binds 2>/dev/null | awk '
+      /^bind/ { if (f["dispatcher"] == "submap") printf "%s\x1f%s\x1f%s\n", f["modmask"], f["key"], f["arg"]; delete f; next }
+      match($0, /^\t[a-z]+: /) { f[substr($0, 2, RLENGTH - 3)] = substr($0, RLENGTH + 1) }
+      END { if (f["dispatcher"] == "submap") printf "%s\x1f%s\x1f%s\n", f["modmask"], f["key"], f["arg"] }
+    '
+  )
+}
