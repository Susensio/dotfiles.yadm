# shellcheck shell=sh
# Xsession sources this file after 95dbus_update-activation-env imports the
# entire X11 environment. Clear its overrides for environment.d names here.
GEN=/usr/lib/systemd/user-environment-generators/30-systemd-environment-d-generator

if [ -x "$GEN" ] && systemctl --user show-environment >/dev/null 2>&1; then
  (
    # Subshell keeps Xsession's positional arguments and globbing setting.
    set -f
    # Generator emits whitespace-free variable names; splitting is intentional.
    # shellcheck disable=SC2046
    set -- $("$GEN" | cut -d= -f1)
    if [ "$#" -gt 0 ]; then
      systemctl --user unset-environment "$@"
    fi
  )
fi
