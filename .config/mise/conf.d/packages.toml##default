# Distro-sourced tools, installed through mise on machines without a variant for their distro.
# Keep in sync with packages.toml##distro_family.arch; `tool` writes both (docs/adr/0046).
[tools]
bat = "latest"
delta = "latest"
eza = "latest"
fd = "latest"
fzf = "latest"
gh = "latest"
glow = "latest"
go = "latest"
gum = "latest"
# Upstream ships only hx; helix is the name EDITOR and Arch use (docs/adr/0047)
helix = { version = "latest", postinstall = 'cd "$MISE_TOOL_INSTALL_PATH"/helix-*/ && ln -sfn hx helix' }
hyperfine = "latest"
just = "latest"
lazygit = "latest"
neovim = "latest"
node = "latest"
pandoc = "latest"
python = "latest"
ripgrep = "latest"
rust = "latest"
tealdeer = "latest"
tmux = "latest"
uv = "latest"
yadm = "latest"
btop = "latest"
