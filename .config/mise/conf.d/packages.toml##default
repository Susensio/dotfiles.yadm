# Distro-sourced tools, installed through mise on machines without a variant for their distro.
# Keep in sync with packages.toml##distro_family.arch; `tool` writes both (docs/adr/0046).
[tools]
bat = "latest"
delta = { version = "latest", pacman = "git-delta", extra_assets = [
  "raw://etc/completion/completion.fish",
] }
eza = { version = "latest", extra_assets = [
  "release://v@completions-$MISE_TOOL_VERSION.tar.gz",
  "release://v@man-$MISE_TOOL_VERSION.tar.gz",
] }
fd = "latest"
fzf = { version = "latest", extra_assets = [
  "raw://v@man/man1/fzf.1",
] }
glow = "latest"
gum = "latest"
# Upstream ships only hx; helix is the name EDITOR and Arch use (docs/adr/0047)
helix = { version = "latest", extra_assets = ["raw://languages.toml"], postinstall = 'cd "$MISE_TOOL_INSTALL_PATH"/helix-*/ && ln -sfn hx helix' }
just = "latest"
lazygit = "latest"
neovim = "latest"
pandoc = { version = "latest", pacman = "pandoc-cli" }
ripgrep = "latest"
tealdeer = { version = "latest", extra_assets = [
  "release://v@completions_fish>tldr.fish",
] }
tmux = { version = "latest", extra_assets = [
  "raw://tmux/tmux:tmux.1",
] }
yadm = { version = "latest", extra_assets = ["raw://@completion/fish/yadm.fish", "raw://@yadm.1"] }
hyperfine = "latest"
