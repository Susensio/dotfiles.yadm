[tools]
# Pin the browser's Wayland proxy until a newer version is tested (docs/omarchy.md).
"cargo:wl-relabel" = "0.1.1"

# Omarchy's preinstalls, kept or removed, applied by `mise bootstrap` through pacman,
# plus the AUR packages this desktop adds. `aur:` means what `pacman:` cannot see:
# no pins, no `absent`, and `--noconfirm` leaves the PKGBUILD review to us (ADR-0102).
# Their launchers and wrappers are yadm/bootstrap.d/omarchy/preinstalls.sh's.
[bootstrap.packages]
"aur:wluma" = "latest"
"aur:zapfast-bin" = "latest"
"pacman:aether" = "latest"
"pacman:libreoffice-fresh" = "latest"
"pacman:omacalc" = "latest"
"pacman:pinta" = "latest"
"pacman:superwhisper-bin" = "latest"
"pacman:cliamp" = { state = "absent" }
"pacman:kdenlive" = { state = "absent" }
"pacman:lazydocker" = { state = "absent" }
"pacman:moonlight-qt" = { state = "absent" }
"pacman:obs-studio" = { state = "absent" }
"pacman:obsidian" = { state = "absent" }
"pacman:omacut" = { state = "absent" }
"pacman:omawrite" = { state = "absent" }
"pacman:voxtype-bin" = { state = "absent" }
"pacman:wtype" = { state = "absent" }
"pacman:xournalpp" = { state = "absent" }

[bootstrap.hooks]
# Omarchy's tldr conflicts with tealdeer. Not `absent`: tealdeer provides tldr,
# so mise would remove tealdeer on every run
pre-packages = "if pacman -Qq tldr 2>/dev/null | grep -qx tldr; then sudo pacman -R --noconfirm tldr; fi"
