#!/usr/bin/env bash
#MISE quiet=true
# Sync global tools to ~/.local/ either manually or via a global postinstall hook.
set -euo pipefail

[[ "${DEBUG:-}" == "1" ]] && set -x

SEP=$'\x1f'
MISE_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/mise

declare -A TARGET_DIRS=(
  [BIN]=${HOME}/.local/bin
  [MAN]=${XDG_DATA_HOME:-$HOME/.local/share}/man
  [FISH_VENDOR_COMPLETIONS]=${XDG_DATA_HOME:-$HOME/.local/share}/fish/vendor_completions.d
  [FISH_VENDOR_CONF]=${XDG_DATA_HOME:-$HOME/.local/share}/fish/vendor_conf.d
  [NODE_MODULES]=${XDG_LIB_HOME:-$HOME/.local/lib}/node_modules
)

# ------------------------------------------------------------------------------
# PRE-FLIGHT & INFRASTRUCTURE
# ------------------------------------------------------------------------------

setup_target_dirs() {
  mkdir --parents "${TARGET_DIRS[@]}"
}

link_roots() {
  printf '%s\n' "${TARGET_DIRS[@]}"
  find "$HOME/.config" -maxdepth 3 -type d -name skills 2>/dev/null
}

prune_broken_links() {
  local roots=()
  readarray -t roots < <(link_roots)
  find "${roots[@]}" \
    -xtype l \
    -lname "*/$(basename "$MISE_HOME")/*" \
    -printf "removed '%p'\n" \
    -delete 2>/dev/null || true
}

# ------------------------------------------------------------------------------
# DATA HELPERS AND UTILS
# ------------------------------------------------------------------------------

list_links() {
  local roots=()
  readarray -t roots < <(link_roots)
  find "${roots[@]}" \
    -type l \
    -lname "*/$(basename "$MISE_HOME")/*" \
    -printf '%p -> %l\n' 2>/dev/null || true
}

get_installed_tools() {
  # Normalize JSON input based on execution context
  local filter_tools=("$@")

  if [[ -n "${MISE_INSTALLED_TOOLS:-}" ]]; then
    echo "$MISE_INSTALLED_TOOLS" | jq --compact-output '.[]'
    return 0
  fi

  mise list --installed --global --json  |
    jq --compact-output 'to_entries | map({name: .key, version: .value[].version}) | .[] |
    select($ARGS.positional == [] or IN(.name; $ARGS.positional[]))' --args "${filter_tools[@]}"
}

init_tool_context() {
  local tool_json=$1
  tool=()

  tool[name]=$(echo "$tool_json" | jq --raw-output '.name')
  tool[version]=$(echo "$tool_json" | jq --raw-output '.version')
  tool[spec]="${tool[name]}@${tool[version]}"
  tool[path]=$(mise where "${tool[spec]}")
  tool[info]=$(mise tool "${tool[name]}" --json 2>/dev/null)
  tool[description]=$(echo "${tool[info]}" | jq --raw-output '.description // empty')

  tool[backend]=$(echo "${tool[info]}" | jq --raw-output '.backend')
  tool[repo]=""
  if [[ "${tool[backend]}" == @(aqua|github):* ]]; then
    tool[repo]="${tool[backend]#*:}"
  fi
}

symlink() {
  local args=("$@")
  local real="${args[-2]}"
  local alias="${args[-1]}"
  local flags=("${args[@]::${#args[@]}-2}")

  local target="$alias"
  [[ -d "$alias" ]] && target="${alias%/}/$(basename "$real")"

  if [[ -e "$target" || -L "$target" ]]; then
    local target_real real_path
    target_real=$(readlink -f -- "$target")
    real_path=$(readlink -f -- "$real")
    [[ "$target_real" == "$real_path" ]] && return 0

    if [[ ! -L "$target" || "$target_real" != "$MISE_HOME/"* ]]; then
      echo "Skipping '$target': existing target is not a managed mise link" >&2
      return 0
    fi
  fi

  ln --symbolic --relative --force --verbose "${flags[@]}" "$real" "$alias"
}

# ------------------------------------------------------------------------------
# CORE TOOL PROCESSING
# ------------------------------------------------------------------------------

process_extra_assets() {
  # (raw|release)://[owner/repo:][v@]path[>filename]
  local extra_assets=()
  readarray -t extra_assets < <(echo "${tool[info]}" | jq -r '.tool_options.extra_assets[]?')

  for asset in "${extra_assets[@]}"; do
    local expanded_asset
    expanded_asset=$(MISE_TOOL_NAME="${tool[name]}" MISE_TOOL_VERSION="${tool[version]}" \
      envsubst '$MISE_TOOL_NAME $MISE_TOOL_VERSION' <<<"$asset")

    # Brace expansion lets one entry list several files from the same
    # folder, e.g. ".../docs/{configuration,keyboard}.mdx". `set -f` keeps
    # `*`/`?` in unrelated URLs from also glob-expanding against the cwd.
    local urls=()
    set -f
    eval "urls=($expanded_asset)"
    set +f

    for url in "${urls[@]}"; do
      local filename=""
      if [[ "$url" == *">"* ]]; then
        filename=${url#*>}
        url=${url%%>*}
        if [[ -z "$filename" || "$filename" == */* || "$filename" == . || "$filename" == .. ]]; then
          echo "Invalid extra asset filename: $filename" >&2
          return 1
        fi
      fi

      local scheme repo tag_prefix path
      IFS=$SEP read -r scheme repo tag_prefix path < <(echo "$url" |
        sed -E "s|^([a-z]+):\/\/(([^:@]+):)?((v?)@)?(.*)$|\1${SEP}\3${SEP}\5${SEP}\6|")

      case "$scheme" in
        raw) url="https://raw.githubusercontent.com/${repo:-${tool[repo]}}/refs/tags/${tag_prefix}${tool[version]}/${path}" ;;
        release) url="https://github.com/${repo:-${tool[repo]}}/releases/download/${tag_prefix}${tool[version]}/${path}" ;;
      esac
      echo "$url"

      local source_filename
      source_filename=$(basename "$url")
      filename=${filename:-$source_filename}
      if [[ "$source_filename" == *.tar.gz ]]; then
        local download_dir=${XDG_CACHE_HOME:-$HOME/.cache}/mise/${tool[name]}
        local download_target=${download_dir}/$filename
        if [[ ! -f "$download_target" ]]; then
          mkdir -p "$download_dir"
          if [[ "$filename" != "$source_filename" ]]; then
            wget --no-verbose --output-document "$download_target" "$url"
          else
            wget --no-verbose --timestamping "$url" -P "$download_dir"
          fi
          tar -xzi --file "$download_target" --directory "${tool[path]}"
        fi
      elif [[ ! -f "${tool[path]}/${filename}" ]]; then
        if [[ "$filename" == "$source_filename" ]]; then
          wget --no-verbose --timestamping "$url" -P "${tool[path]}"
        else
          wget --no-verbose --output-document "${tool[path]}/${filename}" "$url"
        fi
      fi
    done
  done
}

generate() {
  local command=$1
  local filename=$2
  local target_dir=${3:-${tool[path]}}
  local tool_main_bin
  tool_main_bin=$(find "${tool[path]}" -name "${tool[name]}" -executable -print -quit)
  [[ -z "$tool_main_bin" ]] && return 0

  local target="${target_dir%/}/${filename}"
  if [[ ! -s "$target" || "$tool_main_bin" -nt "$target" ]]; then
    local -a command_args
    # Split configured arguments without shell expansion.
    read -r -a command_args <<<"$command"
    {
      # Keep tool init interactive-only.
      [[ "$filename" == config.fish ]] && printf 'if not status is-interactive\n    return\nend\n\n'
      "$tool_main_bin" "${command_args[@]}"
    } >"$target"
  fi
}

generate_completions() {
  local gen_completions
  gen_completions=$(echo "${tool[info]}" | jq -r '.tool_options.gen_completions // empty')
  [[ -z "$gen_completions" ]] && return 0
  generate "$gen_completions" completion.fish
}

generate_shell_init() {
  local gen_shell_init
  gen_shell_init=$(echo "${tool[info]}" | jq -r '.tool_options.gen_shell_init // empty')
  [[ -z "$gen_shell_init" ]] && return 0
  generate "$gen_shell_init" config.fish
}

link_tool_assets() {
  local tool_binaries=()
  readarray -t tool_binaries < <(find -L "$(mise bin-paths "${tool[spec]}")" -maxdepth 1 \
    -type f -executable 2>/dev/null)

  for bin in "${tool_binaries[@]}"; do
    local bin_name
    bin_name=$(basename "$bin")
    symlink "$bin" "${TARGET_DIRS[BIN]}/"

    local fish_completion
    fish_completion=$(find -L "${tool[path]}" -type f \
      \( -name "completion.fish" -o -name "${bin_name}.fish" \) -print -quit 2>/dev/null)
    local fish_completion_target="${TARGET_DIRS[FISH_VENDOR_COMPLETIONS]}/${bin_name}.fish"
    if [[ -n "$fish_completion" && ! -e "$fish_completion_target" ]]; then
      symlink "$fish_completion" "$fish_completion_target"
    fi

    local fish_conf
    fish_conf=$(find -L "${tool[path]}" -type f -name "config.fish" -print -quit 2>/dev/null)
    local fish_conf_target="${TARGET_DIRS[FISH_VENDOR_CONF]}/${tool[name]}.fish"
    if [[ -n "$fish_conf" && ! -e "$fish_conf_target" ]]; then
      symlink "$fish_conf" "$fish_conf_target"
    fi

    local tool_manpages=()
    readarray -t tool_manpages < <(find -L "${tool[path]}" -type f \
      \( -name "$bin_name.[1-9]" -o -name "$bin_name-*.[1-9]" \
         -o -name "$bin_name.[1-9].gz" -o -name "$bin_name-*.[1-9].gz" \) 2>/dev/null)
    for manpage in "${tool_manpages[@]}"; do
      local man_mime
      if [[ "$manpage" == *.gz ]]; then
        man_mime=$(gzip --decompress --stdout -- "$manpage" | file --brief --mime-type -)
      else
        man_mime=$(file --dereference --brief --mime-type -- "$manpage")
      fi
      [[ "$man_mime" == "text/troff" ]] || continue

      local man_base=${manpage%.gz}
      local man_section=${man_base##*.}
      local man_dir=${TARGET_DIRS[MAN]}/man$man_section
      mkdir --parents "$man_dir"
      symlink "$manpage" "${man_dir}/"
    done
  done
}

link_skills() {
  local skills=()
  readarray -t skills < <(echo "${tool[info]}" | jq --compact-output '.tool_options.skills[]?')

  for skill_json in "${skills[@]}"; do
    local name file references is_global
    name=$(echo "$skill_json" | jq --raw-output '.name')
    file=$(echo "$skill_json" | jq --raw-output '.file // empty')
    references=$(echo "$skill_json" | jq --raw-output '.references // empty')
    is_global=$(echo "$skill_json" | jq --raw-output '.global // false')

    # Project-scoped skills mirror into this repo's own agent-config dirs;
    # global ones go where each agent actually looks from any project.
    local skill_roots=()
    if [[ "$is_global" == "true" ]]; then
      skill_roots=(
        "$HOME/.config/claude/skills/$name"
        "$HOME/.config/codex/skills/$name"
        "$HOME/.config/opencode/skills/$name"
        "$HOME/.config/pi/agent/skills/$name"
      )
    else
      skill_roots=(
        "$HOME/.config/.agents/skills/$name"
        "$HOME/.config/.claude/skills/$name"
        "$HOME/.config/.opencode/skills/$name"
      )
    fi

    for skill_root in "${skill_roots[@]}"; do
      if [[ -n "$file" ]]; then
        mkdir -p "$skill_root"
        echo "*" > "$skill_root/.gitignore"
        symlink "${tool[path]}/${file}" "$skill_root/SKILL.md"
      fi

      if [[ -n "$references" ]]; then
        mkdir -p "$skill_root/references"
        echo "*" > "$skill_root/references/.gitignore"
        local ref
        for ref in "${tool[path]}"/$references; do
          [[ -f "$ref" ]] && symlink "$ref" "$skill_root/references/"
        done
      fi
    done
  done
}

link_node_modules() {
  local node_modules_dir=${tool[path]}/lib/node_modules
  [[ ! -d "$node_modules_dir" ]] && return 0

  local node_modules=()
  readarray -t node_modules < <(find -L "$node_modules_dir" -mindepth 1 -maxdepth 1 -type d)
  for node_module in "${node_modules[@]}"; do
    local node_module_target
    node_module_target=${TARGET_DIRS[NODE_MODULES]}/$(basename "$node_module")
    symlink --no-dereference "$node_module" "$node_module_target"
  done
}

# ------------------------------------------------------------------------------
# ENTRY POINT
# ------------------------------------------------------------------------------

# Global postinstall hooks also fire on project installs, but only global-only
# operations and manual runs should trigger a re-sync.
bail_on_project_hook() {
  # Set on any hook run, even a no-op install; manual runs leave it unset.
  [[ -v MISE_INSTALLED_TOOLS ]] &&
    # Distinct for project installs; equal only for global-only operations.
    [[ "${MISE_PROJECT_ROOT:-}" != "${MISE_CONFIG_ROOT:-}" ]]
}

main() {
  bail_on_project_hook && exit 0

  local filter_tools=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --list-links) list_links; exit 0 ;;
      --only-prune) prune_broken_links; exit 0 ;;
      -f|--filter)
        [[ $# -ge 2 ]] || { echo "Missing tool name after $1" >&2; return 2; }
        filter_tools+=("$2"); shift 2
        ;;
      -*) shift ;; # Ignore any other unknown flags
      *) filter_tools+=("$1"); shift ;; # Fallback: append plain positional arguments
    esac
  done

  setup_target_dirs
  prune_broken_links

  local -A tool
  local tools=()
  readarray -t tools < <(get_installed_tools "${filter_tools[@]}")
  for tool_json in "${tools[@]}"; do
    init_tool_context "$tool_json"

    process_extra_assets
    generate_completions
    generate_shell_init
    link_tool_assets
    link_skills
    link_node_modules
  done

  mandb --user-db --quiet
}

main "$@"
