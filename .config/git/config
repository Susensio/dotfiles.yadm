[user]
	name = Saúl Nogueras
	email = susensio@gmail.com
	signingkey = /home/susensio/.ssh/id_ed25519.pub

[init]
	defaultBranch = master

[alias]
	ls = ls-files
	graph = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	root = rev-parse --show-toplevel
	ignore = "!gi() { curl -sL https://www.toptal.com/developers/gitignore/api/$@ ;}; gi"
	fame = !python -m gitfame
	st = status -sb
	last = log -1 HEAD --stat
	cm = commit -m
	big = "!\"${XDG_CONFIG_HOME:-$HOME/.config}/git/scripts/big\""
	blob = log --raw --all --find-object
	aicommit = "!\"${XDG_CONFIG_HOME:-$HOME/.config}/git/scripts/aicommit\""

[credential "https://github.com"]
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper = !gh auth git-credential

[push]
	autoSetupRemote = true
	followTags = true

[pull]
	ff = only

[rebase]
	autoStash = true
	autoSquash = true        # Reorder fixup!/squash! commits automatically
	updateRefs = true        # Move stacked branches along when rebasing

[fetch]
	prune = true             # Drop refs to branches deleted on the remote

[diff]
	algorithm = histogram    # Clearer diffs on moved/edited lines
	colorMoved = plain       # Highlight moved blocks in diffs
	mnemonicPrefix = true    # i/ w/ c/ instead of a/ b/

[merge]
	conflictStyle = zdiff3   # Show common ancestor in conflict markers

[commit]
	verbose = true           # Include diff in commit message editor

[column]
	ui = auto                # Output in columns when possible

[branch]
	sort = -committerdate    # Most recently used branches first

[tag]
	sort = -version:refname  # Sort version numbers as expected

[rerere]
	enabled = true           # Record and reuse conflict resolutions
	autoupdate = true        # Stage reused resolutions automatically

[help]
	autocorrect = prompt     # Offer to run the corrected command on typos

[blame]
	coloring = highlightRecent

[include]
	path = config.local
	path = delta.config
	path = lfs.config
[gpg]
	format = ssh
