#!/usr/bin/env bash
set -eu
[[ "${DEBUG:-}" == "1" ]] && set -x
# exec 2> /tmp/tmux-sessionizer.log

# --- Configuration ---
TMUX_SCRIPTS="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/scripts"
SEP=$'\x1f'
LOOKUP_PATHS=("$HOME/Projects" "${XDG_CONFIG_HOME:-$HOME/.config}")

declare -A ICONS=(
  [NEW]="󰄱 "
  [TMUX]=" "
  [DIR]=" "
  [PROJECT]="󰊢 "
  [CONFIG]=" "
  [CODE]=" "
)

# --- Data Helpers ---
to_row() {
  # $1 kind
  # $2 id
  # $3 name
  # $4 path
  # $5 fzf_display
  local IFS=$SEP
  echo "$*"
}

format_name() {
  local kind=$1 name=$2
  echo "${kind} ${name//./_}" # tmux disallows '.' in session names
}

path_to_row() {
  local path=$1 kind icon short_path name
  short_path="${path##*/}" # vastly faster than basename

  case "$path" in
    "$HOME/.config" | $HOME/.config/*) kind="CONFIG" ;;
    "$HOME/bin" | $HOME/bin/*) kind="CODE" ;;
    $HOME/Projects/*) kind="PROJECT" ;;
    *) kind="DIR" ;;
  esac
  icon=${ICONS[$kind]}
  name="$(format_name "$kind" "$short_path")"

  to_row "$kind" "" "$name" "$path" "$icon ${path/#$HOME/\~}"
}

parse_row() {
  IFS=$SEP read -r kind id name path display <<<"$1"
}

# --- Source Gathering ---
list_sources() {
  local session_row_format sessions current_path

  to_row "NEW" "" "" "$HOME" "${ICONS[NEW]} +New session"

  session_row_format=$(to_row "SESSION" "#{session_id}" "#{session_name}" "#{session_path}" "${ICONS[TMUX]} #{?@session_pretty_name,#{@session_pretty_name},#S}")

  # 1. Unattached sessions first, each group sorted by recent activity
  {
    sessions=$("${TMUX_SCRIPTS}/ls" --mru --unattached-first -F "$session_row_format" 2>/dev/null)
    if [[ -n "$sessions" ]]; then
      echo "$sessions"
    fi
    {
      # 2. Zoxide MRU folders
      zoxide query --list | head -n 50

      # 3. Defined lookup dirs
      find "${LOOKUP_PATHS[@]}" -maxdepth 1 -mindepth 1 -type d 2>/dev/null

      # 4. Current directory and its subfolders
      current_path=$(test -n "${TMUX:-}" && tmux display -pF '#{pane_current_path}' || echo "$PWD")
      echo "$current_path"
      find "$current_path" -maxdepth 1 -mindepth 1 -type d 2>/dev/null
    } | while read -r path; do
      path_to_row "$path"
    done
  # Dedups on name/label (field 3) -- works for paths too, since
  # path_to_row is deterministic: same path always yields the same name.
  } | awk -W interactive -F"$SEP" '!seen[$3]++'
}

if [[ "${1:-}" == "--list" ]]; then
  # Powers the fzf `change` reload below: drops "+New session" so it can't
  # surface as a fuzzy match once the user starts typing a query.
  list_sources | tail -n +2
  exit
fi

# Can be used without interaction
if [[ -n "${1:-}" ]]; then
  selection=$(path_to_row "$1")
else
  # Avoid nested popups. TMUX_PARENT is set by scripts/scratchpad when it
  # launches a popup session, so we can detach and re-target its parent
  # client instead of opening a popup inside a popup.
  # Bare `detach` errors "no current client" when the popup is already gone;
  # closing it is best-effort.
  if [[ -n "${TMUX_PARENT:-}" ]]; then
    tmux detach 2>/dev/null || true
    export TMUX=$TMUX_PARENT
  fi

  # fzf field refs below are positional -- keep in sync with to_row()'s order.
  F_KIND=1
  F_ID=2
  F_NAME=3
  F_PATH=4
  preview_cmd="[[ {$F_KIND} == 'NEW' ]] && exit || [[ {$F_KIND} == 'SESSION' ]] && ${TMUX_SCRIPTS}/preview-session {$F_ID} || eza --color=always --group-directories-first --icons --tree --level=2 --git-ignore -- {$F_PATH}"

  selection=$(
    list_sources | fzf \
      --delimiter="$SEP" \
      --with-nth=-1 \
      --no-sort \
      --scheme=path \
      --preview="$preview_cmd" \
      --bind="change:reload-sync($0 --list)+unbind(change)"
  )
fi

[[ -z "$selection" ]] && exit

handle_selection() {
  local selection=$1
  parse_row "$selection"

  local target_id icon
  case "$kind" in
    NEW)
      target_id=$(tmux new-session -d -c "$path" -P -F "#{session_id}")
      ;;
    SESSION)
      target_id="$id"
      ;;
    *)
      icon=${ICONS[$kind]}
      if tmux has-session -t "=$name" 2>/dev/null; then
        target_id="$(tmux list-sessions -f "#{==:#{session_name},$name}" -F '#{session_id}')"
      else
        target_id=$(tmux new-session -d -s "$name" -c "$path" -P -F "#{session_id}")
        # Lets the status bar show icons without putting them in the (typeable) session name.
        tmux set-option -t "$target_id" '@session_pretty_name' "${icon}${path##*/}"
        zoxide add "$path"
      fi
      ;;
  esac

  [[ -z "$target_id" ]] && { echo "sessionizer: no session (tmux down?)" >&2; exit 1; }

  # --- Execution ---
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$target_id"
  else
    tmux attach-session -t "$target_id"
  fi
}

handle_selection "$selection"
