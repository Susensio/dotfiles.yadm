#!/usr/bin/env bash
set -eu
[[ "${DEBUG:-}" == "1" ]] && set -x

SUFFIX="_scratchpad"
current_socket="$(tmux display -pF "#{b:socket_path}")"

current_client=""
current_session_id=""
scratch_window_name="main"
action="toggle"

while [[ $# -gt 0 ]]; do
  case "$1" in
    clean | toggle) action="$1"; shift ;;
    -c | --client) current_client="$2"; shift 2 ;;
    -s | --session) current_session_id="$2"; shift 2 ;;
    -n | --name) scratch_window_name="$2"; shift 2 ;;
    *) break ;;
  esac
done

command=("$@")

# Already inside a scratchpad popup: read the open window before detaching
# makes it unreachable, so we know whether to close or swap.
if [[ "$current_socket" == *$SUFFIX ]]; then
  if [[ -n "$current_client" ]]; then
    current_window_name="$(tmux display -c "$current_client" -pF '#{window_name}')"
  else
    current_window_name="$(tmux display -pF '#{window_name}')"
  fi

  # Prefer the client the binding gave us; a bare `detach` resolves an
  # ambient "current client" that can fail as "no current client". Never
  # let a failed detach spill a raw tmux error into the popup.
  { [[ -n "$current_client" ]] && tmux detach -t "$current_client" 2>/dev/null; } ||
    tmux detach 2>/dev/null ||
    true

  # Same window requested again: that's the close half of the toggle.
  [[ "$current_window_name" == "$scratch_window_name" ]] && exit 0

  # A different one was requested: fall through to the open flow below,
  # re-pointed at the parent socket/client since this one is now gone.
  current_socket="${current_socket%$SUFFIX}"
  current_client=""
  current_session_id=""
fi

scratch_socket=${current_socket}${SUFFIX}
scratchpad() { tmux -L "$scratch_socket" "$@"; }

# clean is fired from the session-closed hook, which may run with no client
# attached at all, so it must not depend on live client/session lookups --
# only on the --session id the hook passes explicitly. Bail if we weren't
# given one: `kill-session -t ""` kills the *current* session, so an empty
# target here would destroy an unrelated scratchpad. The "=" prefix below
# also guards this; both are deliberate.
if [[ "$action" == "clean" ]]; then
  [[ -n "$current_session_id" ]] || exit 0
  scratch_session_name="$(echo "$current_session_id" | tr '$' '_')"
  # Most sessions never opened a scratchpad, so "session not found" is the
  # normal case for this hook, not an error worth reporting.
  scratchpad kill-session -t "=$scratch_session_name" 2>/dev/null || true
  exit 0
fi

[[ -n "$current_client" ]] || current_client="$(tmux -L "$current_socket" display -pF "#{client_tty}")"
[[ -n "$current_session_id" ]] || current_session_id="$(tmux -L "$current_socket" display -pF "#{session_id}")"

scratch_session_name="$(echo "$current_session_id" | tr '$' '_')"

scratch_session_target="=$scratch_session_name"
scratch_window_target="=$scratch_session_name:=$scratch_window_name"

if ! scratchpad has -t "$scratch_session_target" &>/dev/null; then
  scratchpad new-session -d -s "$scratch_session_name" -n "$scratch_window_name" -e "TMUX_PARENT=$TMUX" "${command[@]}"
elif ! scratchpad has -t "$scratch_window_target" &>/dev/null; then
  scratchpad new-window -d -t "$scratch_session_target" -n "$scratch_window_name" "${command[@]}"
fi

tmux -L "$current_socket" popup -c "$current_client" -w 80% -h 85% -E -b rounded -T "Scratchpad $scratch_window_name" \
  "tmux -L '$scratch_socket' attach -t '$scratch_window_target'"
