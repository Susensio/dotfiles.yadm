#!/usr/bin/env bash
# Full pane-border text: icon (via scripts/icon) + running command + whatever
# extra the title says, once the command name is stripped back out of it.
#
# The title's command name is only stripped from an edge ("hx: main.rs" ->
# "main.rs", "main.rs - hx" -> "main.rs") -- if it's not at the start or end
# we leave the title untouched, since a coincidental mid-string match (e.g.
# claude's own "* task summary" title) can't be told apart from a real one.
#
# Uses literal (non-regex) bash matching throughout so command names with
# regex-special characters (g++, c++...) can't corrupt the match.
set -eu
[[ "${DEBUG:-}" == "1" ]] && set -x
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

get_icon() {
  local cmd="$1"
  [[ -z "$cmd" ]] && return 0
  "$SCRIPT_DIR/icon" "$cmd" 2>/dev/null || true
}

# Strips $cmd if it appears at the start or end of $title,
# along with any leftover separator punctuation (':', '_', '-', ' ').
strip_redundant_cmd() {
  local title="$1" cmd="$2"
  [[ -z "$title" || -z "$cmd" ]] && { printf '%s' "$title"; return; }

  local sep_chars='[:_ -]'

  if [[ "$title" == "$cmd"* ]]; then
    # Prefix match: "hx: main.rs" -> "main.rs"
    local rest="${title#"$cmd"}"
    printf '%s' "${rest##+($sep_chars)}"
  elif [[ "$title" == *"$cmd" ]]; then
    # Suffix match: "main.rs - hx" -> "main.rs"
    local rest="${title%"$cmd"}"
    printf '%s' "${rest%%+($sep_chars)}"
  else
    printf '%s' "$title"
  fi
}

main() {
  local cmd="${1:-}"
  local raw_title="${2:-}"
  local sep="${3:- }"

  local icon
  icon="$(get_icon "$cmd")"

  local extra_title
  extra_title="$(strip_redundant_cmd "$raw_title" "$cmd")"

  local cmd_part="${icon:+$icon }$cmd"

  if [[ -n "$cmd_part" && -n "$extra_title" ]]; then
    printf '%s%s%s' "$cmd_part" "$sep" "$extra_title"
  else
    printf '%s%s' "$cmd_part" "$extra_title"
  fi
}

main "$@"
