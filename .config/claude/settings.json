{
  "env": {
    "CLAUDE_CODE_DISABLE_EXPLORE_PLAN_AGENTS": "1",
    "CLAUDE_CODE_TMUX_TRUECOLOR": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.config/claude/mods/herdr-tab-name"
  },
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(col -b)",
      "Bash(gh search *)",
      "Bash(command -v *)",
      "Bash(git check-ignore *)",
      "Bash(yadm ls-files *)",
      "Bash(claude --version)"
    ],
    "deny": [
      "Agent(leader)",
      "Artifact",
      "CronCreate",
      "CronDelete",
      "CronList",
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "Bash(git-crypt *)",
      "Bash(yadm git-crypt *)",
      "Bash(age *)",
      "Read(~/.config/age/**)",
      "Read(~/.local/share/yadm/repo.git/git-crypt/**)",
      "Bash(gpg *)",
      "Bash(pass *)",
      "Read(~/.local/share/secrets/**)",
      "Read(//**/*.env)",
      "Read(//**/*.envrc)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.keyring)",
      "Read(//**/*auth.json)",
      "Read(//**/*.credentials.json)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.p8)",
      "Read(//**/*.gpg)",
      "Read(//**/*id_rsa*)",
      "Read(//**/*id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.local/share/gnupg/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.password-store/**)",
      "Read(~/.config/rclone/**)",
      "Read(~/.pypirc)",
      "Read(~/.config/pip/pip.conf)",
      "Read(~/.config/hub/**)",
      "Bash(* *.env)",
      "Bash(* *auth.json*)",
      "Bash(* age *)",
      "Bash(* git-crypt *)",
      "Bash(* ~/.config/age*)",
      "Bash(* ~/.config/gh*)",
      "Bash(* ~/.gnupg*)",
      "Bash(* ~/.local/share/gnupg*)",
      "Bash(* ~/.local/share/keyrings*)",
      "Bash(* ~/.ssh*)"
    ],
    "ask": [
      "Bash(pkexec *)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "design": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "artifact-capabilities": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "claude-api": "off",
    "update-config": "name-only",
    "run": "name-only",
    "keybindings-help": "name-only",
    "omarchy-app": "user-invocable-only",
    "improve-codebase-architecture": "user-invocable-only",
    "superwhisper": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/skills-on-launch.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/susensio/.config/claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/prefer-rich-cli.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script $CLAUDE_CONFIG_DIR/hooks/rules-on-write.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/not-your-repo.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/autoformat.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/sandbox-noise.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Read|Write|Edit|MultiEdit|NotebookEdit|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_CONFIG_DIR/hooks/sandbox-noise.py",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "sh \"$CLAUDE_CONFIG_DIR/statusline.sh\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "sh \"$CLAUDE_CONFIG_DIR/subagent-statusline.sh\""
  },
  "enabledPlugins": {
    "gruvbox@claude-themes": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "claude-themes": {
      "source": {
        "source": "github",
        "repo": "matcra587/claude-themes"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowedDomains": [
        "*"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "/home/susensio/.config/claude",
        "/home/susensio/.config/claude/jobs/*/tmp",
        "/home/susensio/.config/codex",
        "/home/susensio/.local/share/yadm/repo.git",
        "/home/susensio/.cache"
      ]
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "theme": "custom:follow",
  "verbose": false,
  "preferredNotifChannel": "terminal_bell",
  "switchModelsOnFlag": false
}
