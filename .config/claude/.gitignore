# Only the hand-maintained config is version controlled. Everything else here
# is credentials, session transcripts, or churn.
*
!.gitignore
!CLAUDE.md
!settings.json
!keybindings.json
!statusline.sh
!agents/
!agents/**
!skills/
!skills/**
!rules/
!rules/**
!hooks/
!hooks/**

# Regenerable, even inside the whitelisted config dirs (last match wins).
__pycache__/
*.pyc
.ruff_cache/
.claude/
# Anthropic skills synced from the claude.ai account, not hand-maintained.
skills/synced/
# Omarchy's skills, which omarchy/skills.sh links in. No trailing slash: to git
# a symlink is a file, not a directory.
skills/omarchy
skills/diagnose-crash
# herdr's skill, mirrored from its versioned mise install by mise/tasks/herdr-integrations.
skills/herdr/
