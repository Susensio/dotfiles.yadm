# Only the hand-maintained config is version controlled. Everything else here
# is credentials, session transcripts, or churn.
*
!.gitignore
!CLAUDE.md
!settings.json
!settings.cloud.json
!keybindings.json
!statusline.sh
!agents/
!agents/**
!skills/
!skills/**
!rules/
!rules/**
!hooks/
!hooks/**
!mods/
!mods/**
!themes/
!themes/**
# The yadm alt link for the pair beside it.
themes/follow.json

# Regenerable, even inside the whitelisted config dirs (last match wins).
__pycache__/
*.pyc
.ruff_cache/
.claude/
# Engine-generated beside each mod when it loads.
mods/*/tsconfig.json
mods/*/.claude-plugin/types/
# Anthropic skills synced from the claude.ai account, not hand-maintained.
skills/synced/
# Omarchy's skills, which omarchy/skills.sh links in. No trailing slash: to git
# a symlink is a file, not a directory.
skills/omarchy
skills/diagnose-crash
skills/omarchy-app
skills/superwhisper
skills/herdr/
