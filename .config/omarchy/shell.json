{
  "version": 1,
  "idle": {
    "screensaver": 300,
    "lock": 900
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.spacer",
          "size": 6
        },
        {
          "id": "susensio.scratchpad"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 1990,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "akitaonrails.ai-usagebar",
          "lastSelectedEntryId": "anthropic",
          "showAll": true,
          "showProvider": false,
          "showValue": true
        },
        {
          "id": "omarchy.spacer",
          "size": 6
        },
        {
          "id": "omarchy.tray",
          "pinned": [],
          "hidden": [
            "chrome_status_icon_1"
          ]
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "rohaquinlop.agent-collectors"
    }
  ]
}
