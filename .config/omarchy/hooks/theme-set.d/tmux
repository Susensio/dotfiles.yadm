#!/usr/bin/env bash
set -euo pipefail

config_dir="$HOME/.config/tmux/conf.d"
socket=default
if [[ -n ${TMUX:-} ]]; then
  socket=$(tmux display-message -p '#{b:socket_path}')
fi
main_socket=${socket%_scratchpad}

# default too: a switch run from inside herdr's scratchpad derives a main socket that does not exist
for socket in $(printf '%s\n' "$main_socket" "${main_socket}_scratchpad" default default_scratchpad | awk '!seen[$0]++'); do
  # has-session does not create a server when this socket is absent.
  env -u TMUX tmux -L "$socket" has-session 2>/dev/null || continue
  # Only servers that loaded tmux.conf; herdr's scratchpad shim deliberately skips it
  env -u TMUX tmux -L "$socket" show-environment -gh TMUX_CONFIG_DIR &>/dev/null || continue
  env -u TMUX tmux -L "$socket" source-file "$config_dir/30_gruvbox.conf"
  env -u TMUX tmux -L "$socket" source-file "$config_dir/31_palette.conf"
  env -u TMUX tmux -L "$socket" source-file "$config_dir/32_visual.conf"
  # 32 resets what the scratchpad branch of 50 overrides
  if [[ $socket == *_scratchpad ]]; then
    env -u TMUX tmux -L "$socket" source-file "$config_dir/50_scratchpad.conf"
  fi
done
