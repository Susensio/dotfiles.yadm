#!/usr/bin/env bash
set -euo pipefail

theme=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/themes/omarchy-system.json

# BUG: Bun's fs.watch reports a rename into a directory under the temporary
# file's name only, so Pi ignores omarchy-theme-set-pi's atomic replace; an
# attribute change on the final name reaches every running session. Fixed in
# Bun 1.4.0 (oven-sh/bun#36328); drop this once a Pi release builds on it
# (earendil-works/pi#11319, merged after v1.4.0).
[[ -f $theme ]] && touch "$theme"
