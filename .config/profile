# if running bash
if [ -n "$BASH_VERSION" ]; then
  # include bashrc if it exists
  if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc" ]; then
    . "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc"
  fi
fi

# Import environment variables defined in ~/.config/environment.d/*.conf
# Unconditional: see ADR-0043 for why the old DISPLAY/WAYLAND_DISPLAY guard
# was dropped, and why this must exclude shell-managed names.
if command -v systemctl >/dev/null; then
  set -a
  eval "$(systemctl --user show-environment | grep -Ev '^(PWD|USER|HOME|SHELL|SHLVL|_)=')"
  set +a
fi
